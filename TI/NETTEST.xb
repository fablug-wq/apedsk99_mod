100 REM TI-NET TEST - APEDSK99 BRANCH BBS-TERMINAL
110 REM PROVA DEI COMANDI >70->73 (EXTENDED BASIC + 32K)
120 CALL CLEAR :: CALL INIT :: DIM B(31)
130 CALL LOAD(24568,208)
140 CALL LOAD(24552,115)
150 CALL LOAD(24520,254) :: CALL LOAD(24552,114) :: CALL PEEK(24520,N)
160 IF N<>255 THEN PRINT "FIRMWARE SENZA TERMINALE" :: PRINT "(CALLBF=";N;")" :: STOP
170 PRINT "TI-NET TEST" :: PRINT
180 INPUT "HOST[:PORTA]? ":H$ :: IF LEN(H$)=0 OR LEN(H$)>31 THEN 180
190 FOR I=1 TO LEN(H$) :: CALL LOAD(24519+I,ASC(SEG$(H$,I,1))) :: NEXT I
200 CALL LOAD(24520+LEN(H$),0) :: CALL LOAD(24552,112) :: CALL PEEK(24518,S)
210 IF S<>255 THEN PRINT "CONNESSIONE NON RIUSCITA" :: GOTO 180
220 PRINT "CONNESSO. FCTN-9 = CHIUDI" :: PRINT :: L$="" :: T=0 :: E=0 :: TB=0
230 CALL KEY(0,K,ST) :: IF ST=0 THEN 260
240 IF K=15 THEN 400
250 CALL LOAD(24520,1,K) :: CALL LOAD(24552,113)
260 CALL LOAD(24552,114) :: CALL PEEK(24520,N)
270 IF N=255 THEN PRINT L$ :: PRINT "CHIUSA DALLA BBS. BYTE:";TB :: STOP
280 IF N=0 THEN 230
290 IF N>31 THEN PRINT "RISPOSTA NON VALIDA:";N :: STOP
300 FOR I=1 TO N :: CALL PEEK(24520+I,C) :: B(I)=C :: NEXT I :: TB=TB+N
310 FOR J=1 TO N :: C=B(J) :: GOSUB 500 :: NEXT J
320 GOTO 230
400 CALL LOAD(24552,115) :: PRINT L$ :: PRINT "CHIUSO. BYTE:";TB :: END
500 REM UN BYTE RICEVUTO: TELNET, SEQUENZE ESC, TESTO
510 ON T+1 GOTO 520,600,640,700,710
520 IF C=255 THEN T=1 :: RETURN
530 IF E THEN 750
540 IF C=27 THEN E=1 :: RETURN
550 IF C=13 THEN PRINT L$ :: L$="" :: RETURN
560 IF C=8 AND LEN(L$)>0 THEN L$=SEG$(L$,1,LEN(L$)-1)
570 IF C<32 OR C>126 THEN RETURN
580 L$=L$&CHR$(C) :: IF LEN(L$)=28 THEN PRINT L$ :: L$=""
590 RETURN
600 REM DOPO IAC: VERBO, SB O ALTRO
610 IF C>=251 AND C<=254 THEN V=C :: T=2 :: RETURN
620 IF C=250 THEN T=3 :: RETURN
630 T=0 :: RETURN
640 REM OPZIONE: DO A WILL ECHO/SGA, DONT/WONT AL RESTO
650 T=0 :: R=0
660 IF V=251 THEN R=254
670 IF V=251 AND (C=1 OR C=3) THEN R=253
680 IF V=253 THEN R=252
690 IF R THEN CALL LOAD(24520,3,255,R,C) :: CALL LOAD(24552,113)
695 RETURN
700 IF C=255 THEN T=4
705 RETURN
710 T=3 :: IF C=240 THEN T=0
715 RETURN
750 IF E=1 THEN E=-2*(C=91) :: RETURN
760 IF C>=64 AND C<=126 THEN E=0
770 RETURN
