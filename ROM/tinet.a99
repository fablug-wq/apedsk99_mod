********************************************************************************
* TI-NET TERM 0.3 - telnet / BBS terminal for the TI-99/4A with APEDSK99
*
* 16K cartridge ROM at >6000, two banks of 8K (non-inverted: a write to >6000
* selects bank 0, to >6002 bank 1). Needs the 32K memory expansion and the APEDSK99
* firmware with the network terminal commands (>70 CONNECT, >71 SEND,
* >72 RECV, >73 CLOSE: see docs/BBS-terminal.md). Works with any APEDSK99 DSR.
*
* - 40 columns (text mode) or 64 columns (bitmap mode, 4 x 8 cells, two colours);
*   rows 0-22 for the BBS, row 23 status line (optional)
* - characters 32-95 from the console GROM, 96-255 from font.a99 (true lower
*   case, CP437 accented letters, box drawing, blocks, shades)
* - telnet: DO to WILL ECHO / SGA, WILL TTYPE ("ANSI"), WILL NAWS (40 x rows),
*   WONT / DONT to the rest
* - ANSI: cursor A B C D G H f d s u, erase J K, n (6n: cursor report);
*   SGR (m) colours are read and ignored (one colour pair in text mode)
* - local echo: AUTO (on while the server has not said WILL ECHO), on, off;
*   ENTER sends CR or CR LF: for services that are not BBSes (POP3, SMTP...)
* - address book and options in DSK1.BBSLIST (DIS/VAR 80): "#P<n>S<n>E<n>N<n>"
*   (palette, status row, echo, ENTER) then one "name|host[:port]" per entry
*
* Source: tinet.a99 (this file: shared by both banks), menu.a99 (bank 0:
* address book, options, DSK1.BBSLIST), term.a99 (bank 1: the terminal).
* Texts: text_en / term_en (default) or text_it / term_it (-D ITALIAN).
* Build: build.sh -> TINET8.bin (English) and TINETI8.bin (Italian)
********************************************************************************
       DEF  START

* --- hardware
VDPWD  EQU  >8C00
VDPWA  EQU  >8C02
VDPRD  EQU  >8800
VDPSTA EQU  >8802
GRMWA  EQU  >9C02
GRMRD  EQU  >9800
KMODE  EQU  >8374
KCODE  EQU  >8375
GSTAT  EQU  >837C
GPLWS  EQU  >83E0
WS     EQU  >8300

* --- APEDSK99 (fixed in the firmware)
CALLST EQU  >5FC6
CALLBF EQU  >5FC8
ACOMND EQU  >5FE8
WCOMND EQU  >5FF8

* --- VDP memory
PATTAB EQU  >0800
PAB    EQU  >1000
VBUF   EQU  >1080
STROW  EQU  23*40

* --- variables in the 32K (low memory)
V      EQU  >2000
ROW    EQU  V+0
COL    EQU  V+2
SROW   EQU  V+4
SCOL   EQU  V+6
TST    EQU  V+8
TVERB  EQU  V+10
EST    EQU  V+12
NP     EQU  V+14
PRIV   EQU  V+16
PAR    EQU  V+18
SBN    EQU  V+34
SBBUF  EQU  V+36
TXN    EQU  V+44
TXBUF  EQU  V+46
RXN    EQU  V+110
RXBUF  EQU  V+112
CURON  EQU  V+144
CURAD  EQU  V+146
CURCH  EQU  V+148
ROWS   EQU  V+150
STATL  EQU  V+152
PAL    EQU  V+154
FRM    EQU  V+156
SECS   EQU  V+158
FLEN   EQU  V+160
FIELD  EQU  V+162
BOOKN  EQU  V+194
FWOK   EQU  V+196
NAMBUF EQU  V+198
WSSAV  EQU  V+206
DLFND  EQU  V+238
NLEN   EQU  V+240
NAME   EQU  V+242
RECLEN EQU  V+260
BKSEL  EQU  V+>2F0
COLS   EQU  V+>2F8
ROWB   EQU  V+>2FA
FILLB  EQU  V+>2FC
COLM   EQU  V+>2FE
PALV   EQU  V+>400
STP    EQU  V+>402
SANSI  EQU  V+>404
CURR   EQU  V+>406
CURC   EQU  V+>408
BTMP   EQU  V+>40A
TSTR   EQU  V+>412
ECHOM  EQU  V+>2F2
CRLF   EQU  V+>2F4
SRVECH EQU  V+>2F6
BOOK   EQU  V+262
ESIZE  EQU  48
NSIZE  EQU  16
SCRBUF EQU  V+>300
RECBUF EQU  V+>700
SVOPT  EQU  V+>7F0
SVBK   EQU  V+>7F2
SOPT   EQU  V+>800
COPT   EQU  V+>80A
SBK    EQU  V+>820
CBK    EQU  V+>A00
STACK  EQU  >3FF0

* --- keys (KSCAN mode 5)
K.AID  EQU  1
K.QUIT EQU  5
K.REDO EQU  6
K.ERAS EQU  7
K.LEFT EQU  8
K.RGHT EQU  9
K.DOWN EQU  10
K.UP   EQU  11
K.ENTR EQU  13
K.BACK EQU  15
K.DEL  EQU  3
K.PROC EQU  12

********************************************************************************
* shared by both banks: header, start, bank switching, VDP, keyboard
********************************************************************************
       BANK ALL,>6000
       BYTE >AA,>01,>00,>00
       DATA 0
       DATA PROGS
       DATA 0
       DATA 0
PROGS  DATA 0
       DATA START
       BYTE 11
       TEXT 'TI-NET TERM'
       EVEN

START  LIMI 0
       LWPI WS
       CLR  @>6000                   * bank 0
       B    @START0

* to the terminal (bank 1) and back to the address book (bank 0)
GOTERM CLR  @>6002
       B    @TERM
GOBOOK CLR  @>6000
       B    @BOOKSC

********************************************************************************
* APEDSK99 network commands
********************************************************************************
* R0 = command in the high byte -> R0 = CALLST
NETCMD MOVB R0,@ACOMND
       MOVB @CALLST,R0
       SRL  R0,8
       B    *R11


********************************************************************************
* keyboard: R0 = the key (KSCAN mode 5), 0 if none
********************************************************************************
KEY    LI   R0,>0500
       MOVB R0,@KMODE
       LWPI GPLWS
       BL   @>000E
       LWPI WS
       CLR  R0
       MOVB @GSTAT,R1
       ANDI R1,>2000
       JEQ  KY9
       MOVB @KCODE,R0
       SRL  R0,8
KY9    B    *R11

********************************************************************************
* screen helpers
********************************************************************************
VWA    ORI  R0,>4000
VRA    SWPB R0
       MOVB R0,@VDPWA
       SWPB R0
       MOVB R0,@VDPWA
       ANDI R0,>3FFF
       B    *R11
VWTR   SWPB R0
       MOVB R0,@VDPWA
       SWPB R0
       ORI  R0,>8000
       MOVB R0,@VDPWA
       B    *R11
* R0 address, R1 byte (high)
VSBW   MOV  R11,R8
       BL   @VWA
       MOVB R1,@VDPWD
       B    *R8
* R0 address, R1 CPU address, R2 count
VMBW   MOV  R11,R8
       BL   @VWA
VW1    MOVB *R1+,@VDPWD
       DEC  R2
       JNE  VW1
       B    *R8
VMBR   MOV  R11,R8
       BL   @VRA
VR1    MOVB @VDPRD,*R1+
       DEC  R2
       JNE  VR1
       B    *R8
* R0 address, R1 byte (high), R2 count
VFILL  MOV  R11,R8
       BL   @VWA
VF1    MOVB R1,@VDPWD
       DEC  R2
       JNE  VF1
       B    *R8
* R0 address, R1 string ending with 0 -> R1 after the 0
PRZ    MOV  R11,R8
       BL   @VWA
       JMP  PZ1
PRZC   MOV  R11,R8
PZ1    MOVB *R1+,R2
       JEQ  PZ9
       MOVB R2,@VDPWD
       JMP  PZ1
PZ9    B    *R8
* R0 address, R1 string ending with 0, at most R2 characters
PRN    MOV  R11,R8
       BL   @VWA
PN1    MOVB *R1+,R3
       JEQ  PN9
       MOVB R3,@VDPWD
       DEC  R2
       JNE  PN1
PN9    B    *R8
* R3 = list of (VDP address, string), >FFFF at the end
DRAWL  DECT R10
       MOV  R11,*R10
DW1    MOV  *R3+,R0
       CI   R0,>FFFF
       JEQ  DW9
       MOV  *R3+,R1
       BL   @PRZ
       JMP  DW1
DW9    MOV  *R10+,R11
       B    *R11
CLS    CLR  R0
       LI   R1,>2000
       LI   R2,960
       B    @VFILL


       BANK 0
       COPY "menu.a99"

       BANK 1
       COPY "term.a99"

       END
