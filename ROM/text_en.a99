* text_en.a99 - APEDSK TERMINAL: address book and options texts in English (the default)
MTITLE TEXT ' APEDSK TERMINAL 1.0'
       BYTE 0
MQUIT  TEXT 'F= QUIT'
       BYTE 0
MTITLO TEXT ' APEDSK TERMINAL 1.0 '
       BYTE >FA
       TEXT ' OPTIONS'
       BYTE 0
MBOOK  TEXT 'ADDRESS BOOK'
       BYTE 0
MADDR  TEXT 'OR TYPE HOST[:PORT]'
       BYTE 0
MKEYS1 TEXT 'FCTN-E/X CHOOSE  ENTER CALL  F8 ADD'
       BYTE 0
MKEYS2 TEXT 'F3 DELETE F5 LOAD F6 SAVE F9 OPTIONS'
       BYTE 0
MKEYS3 TEXT '1-6 CHANGE  F9 ADDRESS BOOK'
       BYTE 0
MKEYS4 TEXT 'ANY KEY TO GO BACK TO THE MENU'
       BYTE 0
MOPT1  TEXT '1  Palette ...........'
       BYTE 0
MOPT2  TEXT '2  Status row ........'
       BYTE 0
MOPT3  TEXT '3  Local echo ........'
       BYTE 0
MOPT4  TEXT '4  ENTER sends .......'
       BYTE 0
MOPT5  TEXT '5  Columns ...........'
       BYTE 0
MOPT6  TEXT '6  ANSI colours ......'
       BYTE 0
MF18Y  TEXT 'F18A: 80 columns and colours.'
       BYTE 0
MF18N  TEXT 'No F18A: 40 or 64 columns, no colours.'
       BYTE 0
MFWOK  TEXT 'APEDSK99 firmware: terminal OK'
       BYTE 0
MFWT   TEXT 'The terminal cannot start:'
       BYTE 0
MFWOLD TEXT 'this APEDSK99 firmware has no terminal'
       BYTE 0
MNOAPE TEXT 'APEDSK99 does not answer.'
       BYTE 0
MFW2   TEXT 'It needs the firmware of the branch'
       BYTE 0
MFW3   TEXT 'bbs-terminal (commands >70->73).'
       BYTE 0
MCONN  TEXT 'Connecting to '
       BYTE 0
MDOTS  TEXT '...'
       BYTE 0
MNOCON TEXT 'Connection failed.'
       BYTE 0
MNAME  TEXT 'NAME:'
       BYTE 0
MPORT  TEXT 'PORT:'
       BYTE 0
MPDEF  TEXT '(default=23)'
       BYTE 0
MLOAD  TEXT 'LOAD:'
       BYTE 0
MSAVE  TEXT 'SAVE:'
       BYTE 0
MFULL  TEXT 'Address book full (9 entries).'
       BYTE 0
MADDED TEXT 'Added. F6 saves the file.'
       BYTE 0
MLOADD TEXT 'Loaded.'
       BYTE 0
MSAVED TEXT 'Saved.'
       BYTE 0
MDSKER TEXT 'Disk error.'
       BYTE 0
MEMPTY BYTE 0
MDELQ  TEXT 'Delete which entry (1-9)?'
       BYTE 0
MDELD  TEXT 'Entry deleted. F6 saves the file.'
       BYTE 0
MYES   TEXT 'YES           '
       BYTE 0
MNO    TEXT 'NO            '
       BYTE 0
MAUTO  TEXT 'AUTO          '
       BYTE 0
MCR    TEXT 'CR            '
       BYTE 0
MCRLF  TEXT 'CR LF         '
       BYTE 0
MC40   TEXT '40            '
       BYTE 0
MC64   TEXT '64            '
       BYTE 0
MC80   TEXT '80 (F18A)     '
       BYTE 0
       EVEN
YNNAM  DATA MNO,MYES
ECHNAM DATA MAUTO,MYES,MNO
CRNAM  DATA MCR,MCRLF
COLNAM DATA MC40,MC64,MC80
PALNAM DATA PNM0,PNM1,PNM2
PNM0   TEXT 'WHITE ON BLUE '
       BYTE 0
PNM1   TEXT 'GREEN ON BLACK'
       BYTE 0
PNM2   TEXT 'BLACK ON CYAN '
       BYTE 0
       EVEN
