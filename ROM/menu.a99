********************************************************************************
* menu.a99 - APEDSK TERMINAL, bank 0: address book, options, LOAD / SAVE
********************************************************************************
* line editor variables
LEDAD  EQU  V+>A00
LEDMX  EQU  V+>A02
LEDMD  EQU  V+>A04

********************************************************************************
* start (bank 0): nothing is read from disk until LOAD
********************************************************************************
START0 LI   R10,STACK
       BL   @F18DET
       BL   @VINIT
       BL   @DEFOPT
       CLR  @BOOKN
       LI   R0,DEFFN
       LI   R1,FNAME
       LI   R2,DEFFNE-DEFFN
SA1    MOVB *R0+,*R1+
       DEC  R2
       JNE  SA1
       LI   R0,DEFXN
       LI   R1,XNAME
       LI   R2,6
SA2    MOVB *R0+,*R1+
       DEC  R2
       JNE  SA2
       BL   @SETCOL
       BL   @FWCHK
       MOV  @FWOK,R0
       JEQ  BOOKSC
       B    @FWERR

* the options' defaults
DEFOPT LI   R0,1
       MOV  R0,@STATL
       MOV  R0,@COLR
       CLR  @PAL
       CLR  @ECHOM
       CLR  @CRLF
       CLR  @COLM
       B    *R11

* F18A? unlock, status register 1 = >E0, then reset its registers (locks it)
* (on a 9918 the writes land in R1, R2 and R7, which VINIT rewrites)
F18DET DECT R10
       MOV  R11,*R10
       BL   @F18UNL
       LI   R0,>0F01
       BL   @VWTR
       MOVB @VDPSTA,R1
       LI   R0,>0F00
       BL   @VWTR
       CLR  @F18
       ANDI R1,>E000
       CI   R1,>E000
       JNE  FD1
       SETO @F18
FD1    LI   R0,>3280
       BL   @VWTR
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* address book screen
********************************************************************************
BOOKSC LI   R10,STACK
       BL   @VINIT
       BL   @SETCOL
       BL   @CLS
       LI   R3,BKSCR
       BL   @DRAWL
       CLR  @FLEN
       CLR  @FIELD
       CLR  @BKSEL
       BL   @BKLIST
BKFLD  BL   @DRFLD
BKLOOP BL   @KEY
       MOV  R0,R0
       JEQ  BKLOOP
       LI   R1,BKKEYS
BK0    MOV  *R1+,R2
       JEQ  BK4
       MOV  *R1+,R3
       C    R0,R2
       JNE  BK0
       B    *R3
BK4    CI   R0,K.LEFT
       JNE  BK5
       MOV  @FLEN,R1
       JEQ  BKLOOP
       DEC  R1
       MOV  R1,@FLEN
       CLR  R2
       MOVB R2,@FIELD(R1)
       JMP  BKFLD
BK5    MOV  @BOOKN,R1
       JEQ  BK6
       CI   R0,K.UP
       JNE  BK5C
       MOV  @BKSEL,R0
       DEC  R0
       JGT  BK5S
       MOV  R1,R0
       JMP  BK5S
BK5C   CI   R0,K.DOWN
       JNE  BK6
       MOV  @BKSEL,R0
       INC  R0
       C    R0,R1
       JLE  BK5S
       LI   R0,1
BK5S   MOV  R0,@BKSEL
       BL   @BKMARK
       MOV  @BKSEL,R0
       DEC  R0
       BL   @ENTRY
       AI   R1,NSIZE
       LI   R2,FIELD
       CLR  R3
BK5A   MOVB *R1+,*R2+
       JEQ  BK5B
       INC  R3
       JMP  BK5A
BK5B   MOV  R3,@FLEN
       JMP  BKFLD
BK6    CI   R0,32
       JL   BKLOOP
       CI   R0,126
       JH   BKLOOP
       MOV  @FLEN,R1
       CI   R1,31
       JHE  BKLOOP
       SWPB R0
       MOVB R0,@FIELD(R1)
       INC  R1
       MOV  R1,@FLEN
       CLR  R2
       MOVB R2,@FIELD(R1)
       JMP  BKFLD
* FCTN-=: the F18A as at power-up (unlocked, the 9918 palette, its registers
* reset, which locks it), then the title screen
BKQUIT MOV  @F18,R0
       JEQ  BQ9
       BL   @F18UNL
       LI   R0,>2FC0
       BL   @VWTR
       LI   R1,PALT0
       LI   R2,32
BQ1    MOVB *R1+,@VDPWD
       DEC  R2
       JNE  BQ1
       LI   R0,>2F00
       BL   @VWTR
       LI   R0,>3280
       BL   @VWTR
BQ9    BLWP @>0000
* F18A unlocked from any state: a write to VR57 while it is unlocked locks it,
* so first VR50 >80 (unlocked: registers reset and locked; locked: ignored,
* or R2 = >80 on a 9918 / an F18A without 80 columns), then >1C twice
F18UNL MOV  R11,R9
       LI   R0,>3280
       BL   @VWTR
       LI   R0,>391C
       BL   @VWTR
       LI   R0,>391C
       BL   @VWTR
       B    *R9
PALT0  BYTE >00,>00,>00,>00,>02,>C3,>05,>D6,>05,>4F,>07,>6F,>0D,>54,>04,>EF
       BYTE >0F,>54,>0F,>76,>0D,>C3,>0E,>D6,>02,>B2,>0C,>5C,>0C,>CC,>0F,>FF
BKOPT  B    @OPTSC
BKKEYS DATA K.ENTR,BKCONN,K.BACK,BKOPT,K.REDO,BKADD,K.ERAS,BKDEL
       DATA K.BEGN,BKLOAD,K.PROC,BKSAVE,K.QUIT,BKQUIT,0

* connect to FIELD (the port asked if it has none)
BKCONN MOV  @FLEN,R0
       JNE  BC0
       B    @BKLOOP
BC0    BL   @PORTQ
       MOV  R0,R0
       JEQ  BC1A
       B    @BKMSGE
BC1A   BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MCONN
       BL   @PRZ
       LI   R1,FIELD
       BL   @PRZC
       LI   R1,MDOTS
       BL   @PRZC
       BL   @CONN
       CI   R0,>FF
       JNE  BKC2
       B    @GOTERM
BKC2   LI   R1,MNOCON
       JMP  BKMSG

* FIELD as a new entry (in memory): the port, then the name
BKADD  MOV  @FLEN,R0
       JNE  BS1
       B    @BKLOOP
BS1    MOV  @BOOKN,R0
       CI   R0,9
       JL   BS2
       LI   R1,MFULL
       JMP  BKMSG
BS2    BL   @PORTQ
       MOV  R0,R0
       JNE  BKMSGE
       BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MNAME
       BL   @PRZ
       LI   R0,16*40+7
       LI   R4,14
       CLR  R5
       CLR  R6
       BL   @LINED
       MOV  R1,R1
       JNE  BKMSGE
       MOV  R0,R0
       JEQ  BKMSGE
       MOV  @BOOKN,R0
       BL   @ENTRY
       LI   R2,NAME
BS3    MOVB *R2+,*R1+
       JNE  BS3
       MOV  @BOOKN,R0
       BL   @ENTRY
       AI   R1,NSIZE
       LI   R2,FIELD
BS4    MOVB *R2+,*R1+
       JNE  BS4
       INC  @BOOKN
       CLR  @FLEN
       CLR  @FIELD
       LI   R1,MADDED
       JMP  BKMSG
BKMSGE LI   R1,MEMPTY
BKMSG  DECT R10
       MOV  R1,*R10
       BL   @MSGCLR
       MOV  *R10+,R1
       LI   R0,16*40+1
       BL   @PRZ
       BL   @BKLIST
       B    @BKFLD

* delete an entry (in memory)
BKDEL  MOV  @BOOKN,R0
       JNE  BD1
       B    @BKLOOP
BD1    BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MDELQ
       BL   @PRZ
BD2    BL   @KEY
       MOV  R0,R0
       JEQ  BD2
       AI   R0,-'1'
       JLT  BKMSGE
       C    R0,@BOOKN
       JHE  BKMSGE
       MOV  R0,R5
       BL   @ENTRY
       MOV  R1,R2
       AI   R2,ESIZE
       MOV  @BOOKN,R3
       S    R5,R3
       DEC  R3
       LI   R6,ESIZE
       MPY  R3,R6
       MOV  R7,R7
       JEQ  BD4
BD3    MOVB *R2+,*R1+
       DEC  R7
       JNE  BD3
BD4    DEC  @BOOKN
       CLR  @BKSEL
       LI   R1,MDELD
       JMP  BKMSG

* FCTN-5: LOAD address book and options from the file asked
BKLOAD LI   R1,MLOAD
       BL   @FNASK
       MOV  R0,R0
       JNE  BKMSGE
       BL   @LOADBK
       LI   R1,MDSKER
       MOV  R0,R0
       JNE  BKMSG
       BL   @SETCOL
       CLR  @BKSEL
       LI   R1,MLOADD
       JMP  BKMSG

* FCTN-6: SAVE address book and options in the file asked
BKSAVE LI   R1,MSAVE
       BL   @FNASK
       MOV  R0,R0
       JNE  BKMSGE
       BL   @SAVEBK
       LI   R1,MDSKER
       MOV  R0,R0
       JNE  BKMSG
       LI   R1,MSAVED
       JMP  BKMSG

* R0 = entry number -> R1 = its address (name; host at +NSIZE)
ENTRY  LI   R1,ESIZE
       MPY  R0,R1
       MOV  R2,R1
       AI   R1,BOOK
       B    *R11

* list the entries, rows 4-12
BKLIST DECT R10
       MOV  R11,*R10
       LI   R0,4*40
       LI   R1,>2000
       LI   R2,9*40
       BL   @VFILL
       CLR  R5
       LI   R6,4*40+1
BL1    C    R5,@BOOKN
       JHE  BL9
       MOV  R5,R1
       AI   R1,'1'
       SWPB R1
       MOV  R6,R0
       BL   @VSBW
       MOV  R5,R0
       BL   @ENTRY
       MOV  R1,R7
       MOV  R6,R0
       AI   R0,2
       LI   R2,14
       BL   @PRN
       MOV  R7,R1
       AI   R1,NSIZE
       MOV  R6,R0
       AI   R0,17
       LI   R2,22
       BL   @PRN
       INC  R5
       AI   R6,40
       JMP  BL1
BL9    MOV  *R10+,R11
       B    *R11

* the mark > in front of the chosen entry (BKSEL, 1-9; 0 none)
BKMARK DECT R10
       MOV  R11,*R10
       CLR  R5
       LI   R0,4*40
BM1    LI   R1,>2000
       INC  R5
       C    R5,@BKSEL
       JNE  BM2
       LI   R1,>3E00
BM2    BL   @VSBW
       AI   R0,40
       CI   R5,9
       JL   BM1
       MOV  *R10+,R11
       B    *R11

* the input field, row 14
DRFLD  DECT R10
       MOV  R11,*R10
       LI   R0,14*40+1
       LI   R1,>3E00
       BL   @VSBW
       LI   R0,14*40+2
       LI   R1,FIELD
       BL   @PRZ
       LI   R1,>DB00
       MOVB R1,@VDPWD
       LI   R1,>2000
       LI   R2,31
       S    @FLEN,R2
DF1    MOVB R1,@VDPWD
       DEC  R2
       JGT  DF1
       MOV  *R10+,R11
       B    *R11

MSGCLR DECT R10
       MOV  R11,*R10
       LI   R0,16*40
       LI   R1,>2000
       LI   R2,80
       BL   @VFILL
       MOV  *R10+,R11
       B    *R11

* FIELD without ':' -> ask the port on row 16 and add it (empty: 23);
* R0 = 1: cancelled
PORTQ  DECT R10
       MOV  R11,*R10
       LI   R1,FIELD
PQ1    MOVB *R1+,R0
       JEQ  PQ2
       CB   R0,@MCOLON
       JNE  PQ1
       JMP  PQ0
PQ2    LI   R4,30
       S    @FLEN,R4
       CI   R4,5
       JLE  PQ3
       LI   R4,5
PQ3    CI   R4,2
       JLT  PQ0                      * no room: the firmware's 23
       DECT R10
       MOV  R4,*R10
       BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MPORT
       BL   @PRZ
       LI   R0,16*40+15
       LI   R1,MPDEF
       BL   @PRZ
       MOV  *R10+,R4
       LI   R0,16*40+8
       CLR  R5
       LI   R6,1
       BL   @LINED
       MOV  R1,R1
       JNE  PQ8
       MOV  R0,R0
       JNE  PQ4
       LI   R0,>3233                 * '23'
       MOV  R0,@NAME
       LI   R0,2
PQ4    MOV  @FLEN,R1
       MOVB @MCOLON,@FIELD(R1)
       INC  R1
       LI   R2,NAME
PQ5    MOVB *R2+,@FIELD(R1)
       INC  R1
       DEC  R0
       JNE  PQ5
       CLR  R2
       MOVB R2,@FIELD(R1)
       MOV  R1,@FLEN
       BL   @DRFLD
       BL   @MSGCLR
PQ0    CLR  R0
       JMP  PQ9
PQ8    LI   R0,1
PQ9    MOV  *R10+,R11
       B    *R11

* the file name on row 16 after the label R1, from FNAME; ENTER -> FNAME and
* PNAME, R0 = 0; FCTN-9 or an empty name: R0 = 1
FNASK  DECT R10
       MOV  R11,*R10
       DECT R10
       MOV  R1,*R10
       BL   @MSGCLR
       MOV  *R10+,R1
       LI   R0,16*40+1
       BL   @PRZ
       LI   R0,FNAME
       MOVB *R0+,R5
       SRL  R5,8
       MOV  R5,R2
       LI   R1,NAME
FA1    MOVB *R0+,*R1+
       DEC  R2
       JGT  FA1
       LI   R0,16*40+7
       LI   R4,32
       CLR  R6
       BL   @LINED
       MOV  R1,R1
       JNE  FA8
       MOV  R0,R0
       JEQ  FA8
       SWPB R0
       MOVB R0,@FNAME
       MOVB R0,@PNAME
       SWPB R0
       LI   R1,NAME
       LI   R2,FNAME+1
       LI   R3,PNAME+1
FA2    MOVB *R1,*R2+
       MOVB *R1+,*R3+
       DEC  R0
       JNE  FA2
       CLR  R0
       JMP  FA9
FA8    LI   R0,1
FA9    MOV  *R10+,R11
       B    *R11

* line editor at VDP address R0 on the buffer NAME, which has R5 characters
* already, at most R4; R6 = 0: any character but '|', 1: digits only
* -> R0 = length, R1 = 0 ENTER, 1 FCTN-9
LINED  DECT R10
       MOV  R11,*R10
       MOV  R0,@LEDAD
       MOV  R4,@LEDMX
       MOV  R6,@LEDMD
LE0    MOV  @LEDAD,R0
       BL   @VWA
       LI   R1,NAME
       MOV  R5,R2
       JEQ  LE0B
LE0A   MOVB *R1+,@VDPWD
       DEC  R2
       JNE  LE0A
LE0B   LI   R1,>DB00
       MOVB R1,@VDPWD
       LI   R1,>2000
       MOVB R1,@VDPWD
LE2    BL   @KEY
       MOV  R0,R0
       JEQ  LE2
       CI   R0,K.ENTR
       JEQ  LE8
       CI   R0,K.BACK
       JEQ  LE7
       CI   R0,K.LEFT
       JNE  LE3
       MOV  R5,R5
       JEQ  LE2
       DEC  R5
       JMP  LE0
LE3    CI   R0,32
       JL   LE2
       CI   R0,126
       JH   LE2
       CI   R0,'|'
       JEQ  LE2
       MOV  @LEDMD,R1
       JEQ  LE4
       CI   R0,'0'
       JL   LE2
       CI   R0,'9'
       JH   LE2
LE4    C    R5,@LEDMX
       JHE  LE2
       SWPB R0
       MOVB R0,@NAME(R5)
       INC  R5
       JMP  LE0
LE7    LI   R1,1
       JMP  LE9
LE8    CLR  R1
LE9    CLR  R0
       MOVB R0,@NAME(R5)
       MOV  R5,R0
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* options screen (they last for the session; SAVE keeps them in the file)
********************************************************************************
OPTSC  LI   R10,STACK
       BL   @CLS
       LI   R3,OPSCR
       BL   @DRAWL
       LI   R0,10*40+1
       LI   R1,MF18N
       MOV  @F18,R2
       JEQ  OP0
       LI   R1,MF18Y
OP0    BL   @PRZ
OP1    CLR  R3
OP1A   MOV  R3,R4
       AI   R4,3
       LI   R5,40
       MPY  R5,R4
       AI   R5,24
       MOV  R5,R0
       MOV  R3,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R6
       MOV  *R6,R6
       SLA  R6,1
       A    @VALTAB(R4),R6
       MOV  *R6,R1
       BL   @PRZ
       INC  R3
       CI   R3,NOPT
       JL   OP1A
OP3    BL   @KEY
       MOV  R0,R0
       JEQ  OP3
       CI   R0,K.BACK
       JEQ  OP5
       CI   R0,K.QUIT
       JNE  OP3A
       B    @BKQUIT
OP3A   AI   R0,-'1'
       CI   R0,NOPT-1
       JH   OP3
       MOV  R0,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R6
       MOV  *R6,R7
       INC  R7
       C    R7,@OPTMAX(R4)
       JH   OP3Z
       CI   R7,2                     * 80 columns: only with the F18A
       JNE  OP4
       CI   R4,8
       JNE  OP4
       MOV  @F18,R0
       JNE  OP4
OP3Z   CLR  R7
OP4    MOV  R7,*R6
       BL   @SETCOL
       JMP  OP1
OP5    B    @BOOKSC

********************************************************************************
* firmware without the terminal commands, or no APEDSK99
********************************************************************************
FWERR  BL   @CLS
       LI   R3,FWSCR
       BL   @DRAWL
       LI   R0,5*40+1
       LI   R1,MFWOLD
       MOV  @FWOK,R2
       DEC  R2
       JEQ  FE1
       LI   R1,MNOAPE
FE1    BL   @PRZ
FE2    BL   @KEY
       MOV  R0,R0
       JEQ  FE2
       B    @BKQUIT

********************************************************************************
* APEDSK99 commands of the menus
********************************************************************************
* CONNECT to FIELD -> R0 = CALLST
CONN   LI   R1,FIELD
       LI   R2,CALLBF
CN1    MOVB *R1+,*R2+
       JNE  CN1
       LI   R0,>7000
       B    @NETCMD

* firmware check: CLOSE, then RECV with the >FE sentinel in CALLBF[0]
FWCHK  LI   R0,>D000
       MOVB R0,@WCOMND
       LI   R0,>7300
       MOVB R0,@ACOMND
       LI   R0,>FE00
       MOVB R0,@CALLBF
       LI   R0,>7200
       MOVB R0,@ACOMND
       MOVB @CALLBF,R0
       SRL  R0,8
       CLR  R1
       CI   R0,>FF
       JEQ  FW1
       INC  R1
       CI   R0,>FE
       JEQ  FW1
       INC  R1
FW1    MOV  R1,@FWOK
       B    *R11

* text mode, the font, the inverse characters
VINIT  DECT R10
       MOV  R11,*R10
       LI   R0,>0000
       BL   @VWTR
       LI   R0,>01F0
       BL   @VWTR
       LI   R0,>F000
       MOVB R0,@>83D4                * KSCAN restores VDP R1 from here
       LI   R0,>0200
       BL   @VWTR
       LI   R0,>0401
       BL   @VWTR
       BL   @CLS
       LI   R0,PATTAB
       CLR  R1
       LI   R2,256
       BL   @VFILL
       LI   R0,PATTAB+256
       BL   @VWA
       LI   R1,>06B4
       MOVB R1,@GRMWA
       SWPB R1
       MOVB R1,@GRMWA
       LI   R2,64                    * 7 rows each: in rows 0-6, as the lower case
VI1    LI   R3,7
VI2    MOVB @GRMRD,@VDPWD
       DEC  R3
       JNE  VI2
       CLR  R1
       MOVB R1,@VDPWD
       DEC  R2
       JNE  VI1
       LI   R0,PATTAB+768
       LI   R1,FONT
       LI   R2,1280
       BL   @VMBW
       LI   R5,INVPR                 * the inverse characters (inverse.py)
VI3    MOVB *R5+,R0
       JEQ  VI9
       SRL  R0,8
       SLA  R0,3
       AI   R0,PATTAB
       LI   R1,BTMP
       LI   R2,8
       BL   @VMBR
       LI   R1,BTMP
       LI   R2,4
VI4    INV  *R1+
       DEC  R2
       JNE  VI4
       MOVB *R5+,R0
       SRL  R0,8
       SLA  R0,3
       AI   R0,PATTAB
       LI   R1,BTMP
       LI   R2,8
       BL   @VMBW
       JMP  VI3
VI9    MOV  *R10+,R11
       B    *R11

SETCOL MOV  @PAL,R1
       MOVB @PALTAB(R1),R0
       SRL  R0,8
       MOV  R0,@PALV                 * for the bitmap and 80-column colours
       AI   R0,>0700
       B    @VWTR
PALTAB BYTE >F4,>31,>17
       EVEN

********************************************************************************
* the file (PNAME): address book and options
********************************************************************************
* -> R0 = error (0: none; the book and the options are replaced)
LOADBK DECT R10
       MOV  R11,*R10
       LI   R1,>0014
       LI   R2,80
       BL   @PABNEW
       BL   @DSRLNK
       MOV  R0,R0
       JNE  LB9
       BL   @DEFOPT
       CLR  @BOOKN
LB1    LI   R1,>0200
       BL   @PABOP
       MOV  R0,R0
       JNE  LB8
       LI   R0,PAB+5
       BL   @VRA
       MOVB @VDPRD,R2
       SRL  R2,8
       MOV  R2,@RECLEN
       JEQ  LB1
       LI   R0,VBUF
       LI   R1,RECBUF
       BL   @VMBR
       BL   @PARSE
       JMP  LB1
LB8    LI   R1,>0100
       BL   @PABOP
       CLR  R0
       MOV  @F18,R1                  * 80 columns saved, no F18A here
       JNE  LB9
       MOV  @COLM,R1
       CI   R1,2
       JNE  LB9
       CLR  @COLM
LB9    MOV  *R10+,R11
       B    *R11

* one record in RECBUF (RECLEN): options or an entry
PARSE  LI   R1,RECBUF
       MOV  @RECLEN,R2
       CB   *R1,@HASH
       JNE  PA5
PA1    DEC  R2
       JEQ  PA9
       INC  R1
       CLR  R3
PA1A   CB   *R1,@OPTLET(R3)
       JEQ  PA1B
       INC  R3
       CI   R3,NOPT
       JL   PA1A
       JMP  PA1
PA1B   MOVB @1(R1),R0
       SRL  R0,8
       AI   R0,-'0'
       SLA  R3,1
       C    R0,@OPTMAX(R3)
       JH   PA1
       MOV  @OPTVAR(R3),R4
       MOV  R0,*R4
       JMP  PA1
PA5    MOV  @BOOKN,R0
       CI   R0,9
       JHE  PA9
       MOV  R11,R9
       MOV  R2,R7
       BL   @ENTRY
       MOV  R7,R2
       MOV  R9,R11
       MOV  R1,R4
       LI   R3,RECBUF
       LI   R5,NSIZE-1
PA6    MOV  R2,R2
       JEQ  PA9
       DEC  R2
       CB   *R3,@BAR
       JEQ  PA7
       MOV  R5,R5
       JEQ  PA6A
       MOVB *R3,*R4+
       DEC  R5
PA6A   INC  R3
       JMP  PA6
PA7    CLR  R0
       MOVB R0,*R4
       INC  R3
       AI   R1,NSIZE
       LI   R5,31
PA8    MOV  R2,R2
       JEQ  PA8B
       MOV  R5,R5
       JEQ  PA8B
       MOVB *R3+,*R1+
       DEC  R2
       DEC  R5
       JMP  PA8
PA8B   CLR  R0
       MOVB R0,*R1
       INC  @BOOKN
PA9    B    *R11

* write the file: the options, then the entries -> R0 = error (0: none)
SAVEBK DECT R10
       MOV  R11,*R10
       LI   R1,>0012
       LI   R2,80
       BL   @PABNEW
       BL   @DSRLNK
       MOV  R0,R0
       JNE  SB9
       LI   R1,RECBUF
       MOVB @HASH,*R1+
       CLR  R3
SBO1   MOVB @OPTLET(R3),*R1+
       MOV  R3,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R4
       MOV  *R4,R0
       AI   R0,'0'
       SWPB R0
       MOVB R0,*R1+
       INC  R3
       CI   R3,NOPT
       JL   SBO1
       BL   @WRREC
       MOV  R0,R0
       JNE  SB8
       CLR  R6
SB1    CLR  R0
       C    R6,@BOOKN
       JHE  SB8
       MOV  R6,R0
       BL   @ENTRY
       MOV  R1,R2
       LI   R1,RECBUF
SB2    MOVB *R2+,*R1+
       JNE  SB2
       DEC  R1
       MOVB @BAR,*R1+
       MOV  R1,R7
       MOV  R6,R0
       BL   @ENTRY
       AI   R1,NSIZE
       MOV  R1,R2
       MOV  R7,R1
SB4    MOVB *R2+,*R1+
       JNE  SB4
       DEC  R1
       BL   @WRREC
       MOV  R0,R0
       JNE  SB8
       INC  R6
       JMP  SB1
SB8    DECT R10
       MOV  R0,*R10
       LI   R1,>0100
       BL   @PABOP
       MOV  *R10+,R0
SB9    MOV  *R10+,R11
       B    *R11

* RECBUF up to R1 -> one record; R0 = error
WRREC  DECT R10
       MOV  R11,*R10
       AI   R1,-RECBUF
       MOV  R1,R5
       LI   R0,VBUF
       LI   R1,RECBUF
       MOV  R5,R2
       BL   @VMBW
       LI   R0,PAB+5
       MOV  R5,R1
       SWPB R1
       BL   @VSBW
       LI   R1,>0300
       BL   @PABOP
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* data (bank 0)
********************************************************************************
HASH   TEXT '#'
BAR    TEXT '|'
MCOLON TEXT ':'
OPTLET TEXT 'PSENCA'
       EVEN
NOPT   EQU  6
* the options: variable, highest value, names of the values
OPTVAR DATA PAL,STATL,ECHOM,CRLF,COLM,COLR
OPTMAX DATA 2,1,2,1,2,1
VALTAB DATA PALNAM,YNNAM,ECHNAM,CRNAM,COLNAM,YNNAM
DEFFN  BYTE 11
       TEXT 'DSK1.APENET'
DEFFNE
DEFXN  BYTE 5
       TEXT 'DSK1.'
       EVEN

* screens: (VDP address, text) ... >FFFF
LINE40 BYTE >C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4
       BYTE >C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,0
       EVEN
BKSCR  DATA 0*40,MTITLE,0*40+32,MQUIT,1*40,LINE40,2*40+1,MBOOK
       DATA 13*40+1,MADDR,21*40,LINE40,22*40+1,MKEYS1,23*40+1,MKEYS2,>FFFF
OPSCR  DATA 0*40,MTITLO,1*40,LINE40,3*40+1,MOPT1,4*40+1,MOPT2,5*40+1,MOPT3
       DATA 6*40+1,MOPT4,7*40+1,MOPT5,8*40+1,MOPT6,12*40+1,MFWOK
       DATA 21*40,LINE40,22*40+1,MKEYS3,>FFFF
FWSCR  DATA 0*40,MTITLE,1*40,LINE40,3*40+1,MFWT,8*40+1,MFW2,9*40+1,MFW3
       DATA 21*40,LINE40,22*40+1,MKEYS4,>FFFF

       .ifdef ITALIAN
       COPY "text_it.a99"
       .else
       COPY "text_en.a99"
       .endif

       COPY "font.a99"
       COPY "inv0.a99"
