********************************************************************************
* menu.a99 - TI-NET TERM, bank 0: address book, options, DSK1.BBSLIST
********************************************************************************
********************************************************************************
* start (bank 0)
********************************************************************************
START0 LI   R10,STACK
       BL   @VINIT
       LI   R0,1
       MOV  R0,@STATL
       CLR  @PAL
       CLR  @ECHOM
       CLR  @CRLF
       CLR  @COLM
       BL   @LOADBK
       LI   R1,SOPT
       BL   @GETOPT
       LI   R1,SBK
       BL   @GETBK
       BL   @SETCOL
       BL   @FWCHK
       MOV  @FWOK,R0
       JEQ  BOOKSC
       B    @FWERR

********************************************************************************
* address book screen
********************************************************************************
BOOKSC LI   R10,STACK
       BL   @VINIT
       BL   @SETCOL
       BL   @CLS
       LI   R3,BKSCR
       BL   @DRAWL
       CLR  @FLEN
       CLR  @FIELD
       CLR  @BKSEL
       BL   @BKLIST
BKFLD  BL   @DRFLD
BKLOOP BL   @KEY
       MOV  R0,R0
       JEQ  BKLOOP
       CI   R0,K.ENTR
       JEQ  BKCONN
       CI   R0,K.BACK
       JNE  BK1
       B    @OPTSC
BK1    CI   R0,K.REDO
       JNE  BK2
       B    @BKSAVE
BK2    CI   R0,K.ERAS
       JNE  BK3
       B    @BKDEL
BK3    CI   R0,K.PROC
       JNE  BK3Q
       B    @BKWR
BK3Q   CI   R0,K.QUIT
       JNE  BK4
       BLWP @>0000
BK4    CI   R0,K.LEFT
       JNE  BK5
       MOV  @FLEN,R1
       JEQ  BKLOOP
       DEC  R1
       MOV  R1,@FLEN
       CLR  R2
       MOVB R2,@FIELD(R1)
       JMP  BKFLD
BK5    MOV  @BOOKN,R1
       JEQ  BK6
       CI   R0,K.UP
       JNE  BK5C
       MOV  @BKSEL,R0
       DEC  R0
       JGT  BK5S
       MOV  R1,R0
       JMP  BK5S
BK5C   CI   R0,K.DOWN
       JNE  BK6
       MOV  @BKSEL,R0
       INC  R0
       C    R0,R1
       JLE  BK5S
       LI   R0,1
BK5S   MOV  R0,@BKSEL
       BL   @BKMARK
       MOV  @BKSEL,R0
       DEC  R0
       BL   @ENTRY
       AI   R1,NSIZE
       LI   R2,FIELD
       CLR  R3
BK5A   MOVB *R1+,*R2+
       JEQ  BK5B
       INC  R3
       JMP  BK5A
BK5B   MOV  R3,@FLEN
       JMP  BKFLD
BK6    CI   R0,32
       JL   BKLOOP
       CI   R0,126
       JH   BKLOOP
       MOV  @FLEN,R1
       CI   R1,31
       JHE  BKLOOP
       SWPB R0
       MOVB R0,@FIELD(R1)
       INC  R1
       MOV  R1,@FLEN
       CLR  R2
       MOVB R2,@FIELD(R1)
       JMP  BKFLD

* connect to FIELD
BKCONN MOV  @FLEN,R0
       JEQ  BKLOOP
       BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MCONN
       BL   @PRZ
       LI   R1,FIELD
       BL   @PRZC
       LI   R1,MDOTS
       BL   @PRZC
       BL   @CONN
       CI   R0,>FF
       JNE  BKC2
       B    @GOTERM
BKC2   BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MNOCON
       BL   @PRZ
       B    @BKLOOP

* save FIELD as a new entry: ask the name
BKSAVE MOV  @FLEN,R0
       JNE  BS1
       B    @BKLOOP
BS1    MOV  @BOOKN,R0
       CI   R0,9
       JL   BS2
       LI   R1,MFULL
       B    @BKMSG
BS2    BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MNAME
       BL   @PRZ
       BL   @LINEIN
       MOV  R0,R0
       JEQ  BS9
       MOV  @BOOKN,R0
       BL   @ENTRY
       LI   R2,NAME
BS3    MOVB *R2+,*R1+
       JNE  BS3
       MOV  @BOOKN,R0
       BL   @ENTRY
       AI   R1,NSIZE
       LI   R2,FIELD
BS4    MOVB *R2+,*R1+
       JNE  BS4
       INC  @BOOKN
       CLR  @FLEN
       CLR  @FIELD
       LI   R1,MADDED
       JMP  BKMSG
BS9    LI   R1,MEMPTY
BKMSG  DECT R10
       MOV  R1,*R10
       BL   @MSGCLR
       MOV  *R10+,R1
       LI   R0,16*40+1
       BL   @PRZ
       BL   @BKLIST
       B    @BKFLD

* delete an entry
BKDEL  MOV  @BOOKN,R0
       JNE  BD1
       B    @BKLOOP
BD1    BL   @MSGCLR
       LI   R0,16*40+1
       LI   R1,MDELQ
       BL   @PRZ
BD2    BL   @KEY
       MOV  R0,R0
       JEQ  BD2
       AI   R0,-'1'
       JLT  BD9
       C    R0,@BOOKN
       JHE  BD9
       MOV  R0,R5
       BL   @ENTRY
       MOV  R1,R2
       AI   R2,ESIZE
       MOV  @BOOKN,R3
       S    R5,R3
       DEC  R3
       LI   R6,ESIZE
       MPY  R3,R6
       MOV  R7,R7
       JEQ  BD4
BD3    MOVB *R2+,*R1+
       DEC  R7
       JNE  BD3
BD4    DEC  @BOOKN
       LI   R1,MDELD
       JMP  BKMSG

* FCTN-6: write the address book (with the options as last saved), after Y/N
BKWR   LI   R1,MCONFB
       BL   @CONFRM
       LI   R1,MEMPTY
       MOV  R0,R0
       JEQ  BKMSG
       LI   R1,CBK
       BL   @GETBK
       LI   R0,SOPT
       MOV  R0,@SVOPT
       LI   R0,CBK
       MOV  R0,@SVBK
       BL   @SAVEBK
       LI   R1,MDSKER
       MOV  R0,R0
       JNE  BKMSG
       LI   R1,SBK
       BL   @GETBK
       LI   R1,MSAVED
       JMP  BKMSG
BD9    LI   R1,MEMPTY
       JMP  BKMSG

* R0 = entry number -> R1 = its address (name; host at +NSIZE)
ENTRY  LI   R1,ESIZE
       MPY  R0,R1
       MOV  R2,R1
       AI   R1,BOOK
       B    *R11

* list the entries, rows 4-12
BKLIST DECT R10
       MOV  R11,*R10
       LI   R0,4*40
       LI   R1,>2000
       LI   R2,9*40
       BL   @VFILL
       CLR  R5
       LI   R6,4*40+1
BL1    C    R5,@BOOKN
       JHE  BL9
       MOV  R5,R1
       AI   R1,'1'
       SWPB R1
       MOV  R6,R0
       BL   @VSBW
       MOV  R5,R0
       BL   @ENTRY
       MOV  R1,R7
       MOV  R6,R0
       AI   R0,2
       LI   R2,14
       BL   @PRN
       MOV  R7,R1
       AI   R1,NSIZE
       MOV  R6,R0
       AI   R0,17
       LI   R2,22
       BL   @PRN
       INC  R5
       AI   R6,40
       JMP  BL1
BL9    MOV  *R10+,R11
       B    *R11

* the mark > in front of the chosen entry (BKSEL, 1-9; 0 none)
BKMARK DECT R10
       MOV  R11,*R10
       CLR  R5
       LI   R0,4*40
BM1    LI   R1,>2000
       INC  R5
       C    R5,@BKSEL
       JNE  BM2
       LI   R1,>3E00
BM2    BL   @VSBW
       AI   R0,40
       CI   R5,9
       JL   BM1
       MOV  *R10+,R11
       B    *R11

* the input field, row 14
DRFLD  DECT R10
       MOV  R11,*R10
       LI   R0,14*40+1
       LI   R1,>3E00
       BL   @VSBW
       LI   R0,14*40+2
       LI   R1,FIELD
       BL   @PRZ
       LI   R1,>DB00
       MOVB R1,@VDPWD
       LI   R1,>2000
       LI   R2,31
       S    @FLEN,R2
DF1    MOVB R1,@VDPWD
       DEC  R2
       JGT  DF1
       MOV  *R10+,R11
       B    *R11

MSGCLR DECT R10
       MOV  R11,*R10
       LI   R0,16*40
       LI   R1,>2000
       LI   R2,40
       BL   @VFILL
       MOV  *R10+,R11
       B    *R11

* read a name (max 14) after the prompt on row 16 -> NAME, R0 = length (0: none)
LINEIN DECT R10
       MOV  R11,*R10
       CLR  R5
LI1    LI   R0,16*40+7
       A    R5,R0
       LI   R1,>DB00
       BL   @VSBW
       LI   R1,>2000
       MOVB R1,@VDPWD
LI2    BL   @KEY
       MOV  R0,R0
       JEQ  LI2
       CI   R0,K.ENTR
       JEQ  LI9
       CI   R0,K.BACK
       JNE  LI3
       CLR  R5
       JMP  LI9
LI3    CI   R0,K.LEFT
       JNE  LI4
       MOV  R5,R5
       JEQ  LI2
       DEC  R5
       JMP  LI1
LI4    CI   R0,'|'
       JEQ  LI2
       CI   R0,32
       JL   LI2
       CI   R0,126
       JH   LI2
       CI   R5,14
       JHE  LI2
       SWPB R0
       MOVB R0,@NAME(R5)
       LI   R1,16*40+7
       A    R5,R1
       MOV  R0,R2
       MOV  R1,R0
       MOV  R2,R1
       BL   @VSBW
       INC  R5
       JMP  LI1
LI9    CLR  R0
       MOVB R0,@NAME(R5)
       MOV  R5,R0
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* options screen
********************************************************************************
OPTSC  LI   R10,STACK
       BL   @CLS
       LI   R3,OPSCR
       BL   @DRAWL
OP1    CLR  R3
OP1A   MOV  R3,R4
       AI   R4,3
       LI   R5,40
       MPY  R5,R4
       AI   R5,24
       MOV  R5,R0
       MOV  R3,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R6
       MOV  *R6,R6
       SLA  R6,1
       A    @VALTAB(R4),R6
       MOV  *R6,R1
       BL   @PRZ
       INC  R3
       CI   R3,5
       JL   OP1A
OP3    BL   @KEY
       MOV  R0,R0
       JEQ  OP3
       CI   R0,K.BACK
       JEQ  OP5
       CI   R0,K.PROC
       JEQ  OPWR
       AI   R0,-'1'
       CI   R0,4
       JH   OP3
       MOV  R0,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R6
       MOV  *R6,R7
       INC  R7
       C    R7,@OPTMAX(R4)
       JLE  OP4
       CLR  R7
OP4    MOV  R7,*R6
       BL   @SETCOL
       BL   @MSGCLR
       JMP  OP1
OP5    B    @BOOKSC

* FCTN-6: write the options (with the address book as last saved), after Y/N
OPWR   LI   R1,MCONFO
       BL   @CONFRM
       LI   R1,MEMPTY
       MOV  R0,R0
       JEQ  OPW8
       LI   R1,COPT
       BL   @GETOPT
       LI   R0,COPT
       MOV  R0,@SVOPT
       LI   R0,SBK
       MOV  R0,@SVBK
       BL   @SAVEBK
       LI   R1,MDSKER
       MOV  R0,R0
       JNE  OPW8
       LI   R1,SOPT
       BL   @GETOPT
       LI   R1,MSAVED
OPW8   DECT R10
       MOV  R1,*R10
       BL   @MSGCLR
       MOV  *R10+,R1
       LI   R0,16*40+1
       BL   @PRZ
       JMP  OP3

* question R1 on row 16 -> R0 = 1 if the answer is YESK
CONFRM DECT R10
       MOV  R11,*R10
       DECT R10
       MOV  R1,*R10
       BL   @MSGCLR
       MOV  *R10+,R1
       LI   R0,16*40+1
       BL   @PRZ
CF1    BL   @KEY
       MOV  R0,R0
       JEQ  CF1
       ANDI R0,>DF
       CI   R0,YESK
       JEQ  CF2
       CLR  R0
       JMP  CF3
CF2    LI   R0,1
CF3    MOV  *R10+,R11
       B    *R11

* current options -> 5 words at R1
GETOPT CLR  R3
GO1    MOV  R3,R4
       SLA  R4,1
       MOV  @OPTVAR(R4),R5
       MOV  *R5,*R1+
       INC  R3
       CI   R3,5
       JL   GO1
       B    *R11

* current address book -> count and 9 entries at R1
GETBK  MOV  @BOOKN,*R1+
       LI   R2,BOOK
       LI   R3,9*ESIZE/2
GB1    MOV  *R2+,*R1+
       DEC  R3
       JNE  GB1
       B    *R11

* R0 = entry number -> R1 = its address in the block at SVBK
SVENT  LI   R1,ESIZE
       MPY  R0,R1
       MOV  R2,R1
       A    @SVBK,R1
       INCT R1
       B    *R11

********************************************************************************
* firmware without the terminal commands, or no APEDSK99
********************************************************************************
FWERR  BL   @CLS
       LI   R3,FWSCR
       BL   @DRAWL
       LI   R0,5*40+1
       LI   R1,MFWOLD
       MOV  @FWOK,R2
       DEC  R2
       JEQ  FE1
       LI   R1,MNOAPE
FE1    BL   @PRZ
FE2    BL   @KEY
       MOV  R0,R0
       JEQ  FE2
       BLWP @>0000

********************************************************************************
* APEDSK99 commands of the menus
********************************************************************************
* CONNECT to FIELD -> R0 = CALLST
CONN   LI   R1,FIELD
       LI   R2,CALLBF
CN1    MOVB *R1+,*R2+
       JNE  CN1
       LI   R0,>7000
       B    @NETCMD

* firmware check: CLOSE, then RECV with the >FE sentinel in CALLBF[0]
FWCHK  LI   R0,>D000
       MOVB R0,@WCOMND
       LI   R0,>7300
       MOVB R0,@ACOMND
       LI   R0,>FE00
       MOVB R0,@CALLBF
       LI   R0,>7200
       MOVB R0,@ACOMND
       MOVB @CALLBF,R0
       SRL  R0,8
       CLR  R1
       CI   R0,>FF
       JEQ  FW1
       INC  R1
       CI   R0,>FE
       JEQ  FW1
       INC  R1
FW1    MOV  R1,@FWOK
       B    *R11

* text mode, the font
VINIT  DECT R10
       MOV  R11,*R10
       LI   R0,>0000
       BL   @VWTR
       LI   R0,>01F0
       BL   @VWTR
       LI   R0,>F000
       MOVB R0,@>83D4                * KSCAN restores VDP R1 from here
       LI   R0,>0200
       BL   @VWTR
       LI   R0,>0401
       BL   @VWTR
       BL   @CLS
       LI   R0,PATTAB
       CLR  R1
       LI   R2,256
       BL   @VFILL
       LI   R0,PATTAB+256
       BL   @VWA
       LI   R1,>06B4
       MOVB R1,@GRMWA
       SWPB R1
       MOVB R1,@GRMWA
       LI   R2,64
VI1    CLR  R1
       MOVB R1,@VDPWD
       LI   R3,7
VI2    MOVB @GRMRD,@VDPWD
       DEC  R3
       JNE  VI2
       DEC  R2
       JNE  VI1
       LI   R0,PATTAB+768
       LI   R1,FONT
       LI   R2,1280
       BL   @VMBW
       MOV  *R10+,R11
       B    *R11

SETCOL MOV  @PAL,R1
       MOVB @PALTAB(R1),R0
       SRL  R0,8
       MOV  R0,@PALV                 * for the bitmap colour table
       AI   R0,>0700
       B    @VWTR
PALTAB BYTE >F4,>31,>17
       EVEN

********************************************************************************
* DSK1.BBSLIST: address book and options
********************************************************************************
* PAB to VDP with opcode and flags from R1 (high: opcode, low: flags)
PABSET DECT R10
       MOV  R11,*R10
       DECT R10
       MOV  R1,*R10
       LI   R0,PAB
       LI   R1,PABT
       LI   R2,PABTE-PABT
       BL   @VMBW
       MOV  *R10+,R1
       LI   R0,PAB
       BL   @VSBW
       LI   R0,PAB+1
       SWPB R1
       BL   @VSBW
       MOV  *R10+,R11
       B    *R11
* R1 high = opcode
PABOP  DECT R10
       MOV  R11,*R10
       LI   R0,PAB
       BL   @VSBW
       BL   @DSRLNK
       MOV  *R10+,R11
       B    *R11

LOADBK DECT R10
       MOV  R11,*R10
       CLR  @BOOKN
       LI   R1,>0014
       BL   @PABSET
       BL   @DSRLNK
       MOV  R0,R0
       JNE  LB9
LB1    LI   R1,>0200
       BL   @PABOP
       MOV  R0,R0
       JNE  LB8
       LI   R0,PAB+5
       BL   @VRA
       MOVB @VDPRD,R2
       SRL  R2,8
       MOV  R2,@RECLEN
       JEQ  LB1
       LI   R0,VBUF
       LI   R1,RECBUF
       BL   @VMBR
       BL   @PARSE
       JMP  LB1
LB8    LI   R1,>0100
       BL   @PABOP
LB9    MOV  *R10+,R11
       B    *R11

* one record in RECBUF (RECLEN): options or an entry
PARSE  LI   R1,RECBUF
       MOV  @RECLEN,R2
       CB   *R1,@HASH
       JNE  PA5
PA1    DEC  R2
       JEQ  PA9
       INC  R1
       CLR  R3
PA1A   CB   *R1,@OPTLET(R3)
       JEQ  PA1B
       INC  R3
       CI   R3,5
       JL   PA1A
       JMP  PA1
PA1B   MOVB @1(R1),R0
       SRL  R0,8
       AI   R0,-'0'
       SLA  R3,1
       C    R0,@OPTMAX(R3)
       JH   PA1
       MOV  @OPTVAR(R3),R4
       MOV  R0,*R4
       JMP  PA1
PA5    MOV  @BOOKN,R0
       CI   R0,9
       JHE  PA9
       MOV  R11,R9
       MOV  R2,R7
       BL   @ENTRY
       MOV  R7,R2
       MOV  R9,R11
       MOV  R1,R4
       LI   R3,RECBUF
       LI   R5,NSIZE-1
PA6    MOV  R2,R2
       JEQ  PA9
       DEC  R2
       CB   *R3,@BAR
       JEQ  PA7
       MOV  R5,R5
       JEQ  PA6A
       MOVB *R3,*R4+
       DEC  R5
PA6A   INC  R3
       JMP  PA6
PA7    CLR  R0
       MOVB R0,*R4
       INC  R3
       AI   R1,NSIZE
       LI   R5,31
PA8    MOV  R2,R2
       JEQ  PA8B
       MOV  R5,R5
       JEQ  PA8B
       MOVB *R3+,*R1+
       DEC  R2
       DEC  R5
       JMP  PA8
PA8B   CLR  R0
       MOVB R0,*R1
       INC  @BOOKN
PA9    B    *R11

* write the file: options from the block at SVOPT, entries from the block at
* SVBK (count, entries) -> R0 = error (0: none)
SAVEBK DECT R10
       MOV  R11,*R10
       LI   R1,>0012
       BL   @PABSET
       BL   @DSRLNK
       MOV  R0,R0
       JNE  SB9
       LI   R1,RECBUF
       MOVB @HASH,*R1+
       CLR  R3
SBO1   MOVB @OPTLET(R3),*R1+
       MOV  R3,R4
       SLA  R4,1
       A    @SVOPT,R4
       MOV  *R4,R0
       AI   R0,'0'
       SWPB R0
       MOVB R0,*R1+
       INC  R3
       CI   R3,5
       JL   SBO1
       BL   @WRREC
       MOV  R0,R0
       JNE  SB8
       CLR  R6
SB1    CLR  R0
       MOV  @SVBK,R4
       C    R6,*R4
       JHE  SB8
       MOV  R6,R0
       BL   @SVENT
       MOV  R1,R2
       LI   R1,RECBUF
SB2    MOVB *R2+,*R1+
       JNE  SB2
       DEC  R1
       MOVB @BAR,*R1+
       MOV  R1,R7
       MOV  R6,R0
       BL   @SVENT
       AI   R1,NSIZE
       MOV  R1,R2
       MOV  R7,R1
SB4    MOVB *R2+,*R1+
       JNE  SB4
       DEC  R1
       BL   @WRREC
       MOV  R0,R0
       JNE  SB8
       INC  R6
       JMP  SB1
SB8    DECT R10
       MOV  R0,*R10
       LI   R1,>0100
       BL   @PABOP
       MOV  *R10+,R0
SB9    MOV  *R10+,R11
       B    *R11

* RECBUF up to R1 -> one record; R0 = error
WRREC  DECT R10
       MOV  R11,*R10
       AI   R1,-RECBUF
       MOV  R1,R5
       LI   R0,VBUF
       LI   R1,RECBUF
       MOV  R5,R2
       BL   @VMBW
       LI   R0,PAB+5
       MOV  R5,R1
       SWPB R1
       BL   @VSBW
       LI   R1,>0300
       BL   @PABOP
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* DSRLNK for the PAB at >1000: R0 = error code (0 none, >FF no such device)
* the usual search: every card >1000->1F00, its device list at >4008, the
* routine called from GPLWS with R12 = CRU base, >8354 = length of the
* device name, >8356 = its end (the '.') in VDP
********************************************************************************
DSRLNK DECT R10
       MOV  R11,*R10
       LI   R0,PAB+9
       BL   @VRA
       MOVB @VDPRD,R1
       SRL  R1,8
       LI   R2,NAMBUF
       CLR  R3
DL1    MOVB @VDPRD,R4
       CB   R4,@PERIOD
       JEQ  DL2
       MOVB R4,*R2+
       INC  R3
       DEC  R1
       JNE  DL1
DL2    MOV  R3,@>8354
       LI   R0,PAB+10
       A    R3,R0
       MOV  R0,@>8356
       LI   R0,WS
       LI   R1,WSSAV
       LI   R2,16
DL3    MOV  *R0+,*R1+
       DEC  R2
       JNE  DL3
       CLR  @DLFND
       LWPI GPLWS
       LI   R12,>0F00
DLNXT  SBZ  0
       AI   R12,>0100
       CI   R12,>2000
       JEQ  DLEND
       MOV  R12,@>83D0
       SBO  0
       LI   R2,>4000
       CB   *R2,@HAA
       JNE  DLNXT
       AI   R2,8
DLL    MOV  *R2,R2
       JEQ  DLNXT
       MOV  R2,@>83D2
       MOV  R2,R1
       INCT R1
       MOV  *R1+,R9
       MOVB @>8355,R5
       CB   R5,*R1+
       JNE  DLNE
       SRL  R5,8
       LI   R6,NAMBUF
DLC    CB   *R6+,*R1+
       JNE  DLNE
       DEC  R5
       JNE  DLC
       BL   *R9
       JMP  DLNE
       SBZ  0
       SETO @DLFND
       JMP  DLEND
DLNE   SBO  0
       MOV  @>83D2,R2
       JMP  DLL
DLEND  LI   R0,WSSAV
       LI   R1,WS
       LI   R2,16
DL4    MOV  *R0+,*R1+
       DEC  R2
       JNE  DL4
       LWPI WS
       LI   R0,>FF
       MOV  @DLFND,R1
       JEQ  DL9
       LI   R0,PAB+1
       BL   @VRA
       MOVB @VDPRD,R0
       SRL  R0,13
DL9    MOV  *R10+,R11
       B    *R11

********************************************************************************
********************************************************************************
* data (bank 0)
********************************************************************************
HAA    BYTE >AA
PERIOD TEXT '.'
HASH   TEXT '#'
BAR    TEXT '|'
OPTLET TEXT 'PSENC'
       EVEN
* the options: variable, highest value, names of the values
OPTVAR DATA PAL,STATL,ECHOM,CRLF,COLM
OPTMAX DATA 2,1,2,1,1
VALTAB DATA PALNAM,YNNAM,ECHNAM,CRNAM,COLNAM
PABT   BYTE 0,>14
       DATA VBUF
       BYTE 80,0
       DATA 0
       BYTE 0,12
       TEXT 'DSK1.BBSLIST'
PABTE
       EVEN

* screens: (VDP address, text) ... >FFFF
LINE40 BYTE >C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4
       BYTE >C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,>C4,0
       EVEN
BKSCR  DATA 0*40,MTITLE,1*40,LINE40,2*40+1,MBOOK
       DATA 13*40+1,MADDR,21*40,LINE40,22*40+1,MKEYS1,23*40+1,MKEYS2,>FFFF
OPSCR  DATA 0*40,MTITLO,1*40,LINE40,3*40+1,MOPT1,4*40+1,MOPT2,5*40+1,MOPT6
       DATA 6*40+1,MOPT7,7*40+1,MOPT8,9*40+4,MOPT4,11*40+1,MOPT5
       DATA 21*40,LINE40,22*40+1,MKEYS3,>FFFF
FWSCR  DATA 0*40,MTITLE,1*40,LINE40,3*40+1,MFWT,8*40+1,MFW2,9*40+1,MFW3
       DATA 21*40,LINE40,22*40+1,MKEYS4,>FFFF

       .ifdef ITALIAN
       COPY "text_it.a99"
       .else
       COPY "text_en.a99"
       .endif

       COPY "font.a99"

