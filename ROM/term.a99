********************************************************************************
* term.a99 - APEDSK TERMINAL, bank 1: the terminal (telnet, ANSI, the screen in
* 40, 64 or 80 columns); the file transfers are in xmodem.a99
********************************************************************************
********************************************************************************
* terminal
********************************************************************************
TERM   LI   R10,STACK
       CLR  @ROW
       CLR  @COL
       CLR  @SROW
       CLR  @SCOL
       CLR  @TST
       CLR  @EST
       CLR  @TXN
       CLR  @CURON
       CLR  @FRM
       CLR  @SECS
       CLR  @SRVECH
       CLR  @ATDEP
       BL   @SGR0
       MOV  @PALV,@DEFATR
       LI   R0,24
       S    @STATL,R0
       MOV  R0,@ROWS
       LI   R0,23
       MOV  R0,@SROWN
       MOV  @COLM,R0
       JEQ  TI40
       DEC  R0
       JEQ  TI64
       LI   R0,80                     * 80 columns (F18A): 25 rows, status row 25
       MOV  R0,@COLS
       MOV  R0,@ROWB
       LI   R0,>2000
       MOV  R0,@FILLB
       LI   R0,25
       MOV  R0,@ROWS
       MOV  R0,@SROWN
       LI   R0,STP80
       MOV  R0,@STP
       LI   R0,MANS80
       MOV  R0,@SANSI
       MOV  @COLR,R0
       JEQ  TI80
       LI   R0,>0070                  * colours: light grey on black
       MOV  R0,@DEFATR
TI80   BL   @F80INI
       JMP  TI2
TI40   LI   R0,40                     * 40 columns: text mode, as the menus left it
       MOV  R0,@COLS
       MOV  R0,@ROWB
       LI   R0,>2000
       MOV  R0,@FILLB
       LI   R0,STP40
       MOV  R0,@STP
       LI   R0,MANS40
       MOV  R0,@SANSI
       BL   @CLS
       JMP  TI2
TI64   LI   R0,64                     * 64 columns: bitmap mode, 4 x 8 cells
       MOV  R0,@COLS
       LI   R0,256
       MOV  R0,@ROWB
       CLR  @FILLB
       LI   R0,STP64
       MOV  R0,@STP
       LI   R0,MANS64
       MOV  R0,@SANSI
       LI   R0,F64ROM                 * the font: bank 2 -> the 32K
       LI   R1,FONT64
       LI   R2,2048
       LI   R3,>6004
       LI   R4,>6002
       BL   @BKCOPY
       BL   @BMINIT
TI2    BL   @MKATTR
       BL   @STATUS

TLOOP  BL   @KEY
       MOV  R0,R0
       JEQ  TL2
       BL   @TKEY
       MOV  R0,R0
       JEQ  TL2
       B    @THANG
TL2    BL   @TXFLSH
       LI   R0,>7200
       BL   @NETCMD
       MOVB @CALLBF,R0
       SRL  R0,8
       JNE  TL3
       BL   @CURSHW
       BL   @CLOCK
       JMP  TLOOP
TL3    CI   R0,>FF
       JNE  TL3A
       B    @TCLOSD
TL3A   CI   R0,31
       JLE  TL3B
       B    @TBAD
TL3B   MOV  R0,@RXN
       MOV  R0,R2
       LI   R1,CALLBF+1
       LI   R3,RXBUF
TL4    MOVB *R1+,*R3+
       DEC  R2
       JNE  TL4
       BL   @CUROFF
       LI   R4,RXBUF
       MOV  @RXN,R5
TL5    CLR  R1
       MOVB *R4+,R1
       SWPB R1
       DECT R10
       MOV  R4,*R10
       DECT R10
       MOV  R5,*R10
       BL   @TNBYTE
       MOV  *R10+,R5
       MOV  *R10+,R4
       DEC  R5
       JNE  TL5
       JMP  TLOOP

* the BBS hung up / a bad answer / we hang up
TCLOSD LI   R1,MCLOSD
       JMP  TEND
TBAD   LI   R1,MBAD
TEND   BL   @CUROFF
       BL   @SRMSG
       BL   @WKEY
THANG  LI   R0,>7300
       BL   @NETCMD
       MOV  @COLM,R0                  * 80 columns: the F18A back as it was
       CI   R0,2
       JNE  TH9
       BL   @F80OFF
TH9    B    @GOBOOK

* the message R1 alone on the status row
SRMSG  DECT R10
       MOV  R11,*R10
       BL   @ATNORM
       DECT R10
       MOV  R1,*R10
       MOV  @SROWN,R5
       LI   R2,1
       BL   @BLROWS
       MOV  *R10+,R1
       MOV  @SROWN,R5
       CLR  R6
       MOV  @COLS,R2
       BL   @SPRT
       BL   @ATREST
       MOV  *R10+,R11
       B    *R11

* wait for a key
WKEY   MOV  R11,R9
WK1    BL   @KEY
       MOV  R0,R0
       JEQ  WK1
       B    *R9

* the status row in the default colours, not inverse (they nest)
ATNORM MOV  @ATDEP,R0
       JNE  AN9
       MOV  @INVM,@SVINV
       MOV  @CATTR,@SVATR
       CLR  @INVM
       MOV  @DEFATR,@CATTR
AN9    INC  @ATDEP
       B    *R11
ATREST DEC  @ATDEP
       JNE  AR9
       MOV  @SVINV,@INVM
       MOV  @SVATR,@CATTR
AR9    B    *R11

* a key in the terminal -> what it sends; R0 = 1: hang up
TKEY   DECT R10
       MOV  R11,*R10
       MOV  R0,R1
       CI   R1,K.BACK
       JNE  TK1
       BL   @TMENU
       JMP  TK9
TK1    CI   R1,K.ENTR
       JEQ  TKSEND
       CI   R1,K.LEFT
       JEQ  TKSEND
       CI   R1,K.AID
       JNE  TK2
       LI   R1,27
       JMP  TKSEND
TK2    CI   R1,K.DEL
       JNE  TK3
       LI   R1,127
       JMP  TKSEND
TK3    CI   R1,K.UP
       JNE  TK4
       LI   R2,'A'
       JMP  TKCSI
TK4    CI   R1,K.DOWN
       JNE  TK5
       LI   R2,'B'
       JMP  TKCSI
TK5    CI   R1,K.RGHT
       JNE  TK6
       LI   R2,'C'
       JMP  TKCSI
TK6    CI   R1,129
       JL   TK7
       CI   R1,154
       JH   TK7
       AI   R1,-128
       JMP  TKSEND
TK7    CI   R1,32
       JL   TK8
       CI   R1,126
       JLE  TKSEND
TK8    CLR  R0
       JMP  TK9
TKCSI  DECT R10
       MOV  R2,*R10
       LI   R1,27
       BL   @TXPUT
       LI   R1,'['
       BL   @TXPUT
       MOV  *R10+,R1
       BL   @TXPUT
       JMP  TKS9
TKSEND BL   @TXPUT
       CI   R1,13
       JNE  TKS2
       MOV  @CRLF,R0
       JEQ  TKS2
       LI   R1,10
       BL   @TXPUT
       LI   R1,13
TKS2   BL   @LECHO
       MOV  R0,R0
       JEQ  TKS9
       DECT R10
       MOV  R1,*R10
       BL   @CUROFF
       MOV  *R10+,R1
       CI   R1,13
       JNE  TKS3
       BL   @CTRL
       LI   R1,10
       JMP  TKS5
TKS3   CI   R1,8
       JNE  TKS4
       BL   @CTRL
       LI   R1,32
       BL   @CTRL
       LI   R1,8
       JMP  TKS5
TKS4   CI   R1,32
       JL   TKS9
       CI   R1,126
       JH   TKS9
TKS5   BL   @CTRL
TKS9   CLR  R0
TK9    MOV  *R10+,R11
       B    *R11

* local echo? R0 = 1 yes: ECHOM 1 (on), or 0 (AUTO) while the server does not echo
LECHO  MOV  @ECHOM,R0
       JEQ  LE1
       DEC  R0
       JEQ  LEY
       CLR  R0
       B    *R11
LE1    MOV  @SRVECH,R0
       JEQ  LEY
       CLR  R0
       B    *R11
LEY    LI   R0,1
       B    *R11

* FCTN-9 during a session: the menu on the status row
TMENU  DECT R10
       MOV  R11,*R10
       BL   @CUROFF
       LI   R1,MMENU
       BL   @SRMSG
       BL   @WKEY
       ANDI R0,>DF
       CI   R0,HANGK
       JNE  TM1
       LI   R0,1
       JMP  TM9
TM1    CI   R0,'D'
       JNE  TM1U
       BL   @XDOWN
       JMP  TM2
TM1U   CI   R0,'U'
       JNE  TM2
       BL   @XUP
TM2    MOV  @STATL,R0                 * the status row back, or the row blank
       JNE  TM3
       BL   @ATNORM
       MOV  @SROWN,R5
       LI   R2,1
       BL   @BLROWS
       BL   @ATREST
TM3    BL   @STATUS
       CLR  R0
TM9    MOV  *R10+,R11
       B    *R11

* the status row: host, ANSI COLSxROWS, time, FCTN-9 (columns from STP)
STATUS MOV  @STATL,R0
       JNE  ST1
       B    *R11
ST1    DECT R10
       MOV  R11,*R10
       BL   @ATNORM
       MOV  @SROWN,R5
       LI   R2,1
       BL   @BLROWS
       MOV  @SROWN,R5
       CLR  R6
       LI   R1,>DE
       BL   @PUTAT
       MOV  @SROWN,R5
       LI   R6,1
       LI   R1,FIELD
       MOV  @STP,R3
       MOV  *R3,R2
       BL   @SPRT
       MOV  @STP,R3
       MOV  @2(R3),R6
       MOV  @SANSI,R1
       LI   R2,20
       BL   @SPRT
       MOV  @STP,R3
       MOV  @6(R3),R6
       LI   R1,MF9
       LI   R2,20
       BL   @SPRT
       BL   @STTIME
       BL   @ATREST
       MOV  *R10+,R11
       B    *R11

STTIME MOV  @STATL,R0
       JNE  SM1
       B    *R11
SM1    DECT R10
       MOV  R11,*R10
       MOV  @SECS,R7
       CLR  R6
       LI   R2,60
       DIV  R2,R6
       LI   R1,TSTR
       MOV  R6,R0
       BL   @DEC2
       MOVB @COLON,*R1+
       MOV  R7,R0
       BL   @DEC2
       CLR  R0
       MOVB R0,*R1
       BL   @ATNORM
       MOV  @SROWN,R5
       MOV  @STP,R3
       MOV  @4(R3),R6
       LI   R1,TSTR
       LI   R2,5
       BL   @SPRT
       BL   @ATREST
       MOV  *R10+,R11
       B    *R11

* R0 = 0-99 -> two digits at R1 (R1 moves on)
DEC2   MOV  R0,R3
       CLR  R2
       LI   R4,10
       DIV  R4,R2
       CI   R2,9
       JLE  D2A
       LI   R2,9
D2A    AI   R2,'0'
       SWPB R2
       MOVB R2,*R1+
       AI   R3,'0'
       SWPB R3
       MOVB R3,*R1+
       B    *R11

* frames from the VDP status flag -> seconds on the status row
CLOCK  MOVB @VDPSTA,R0
       JLT  CK1
       B    *R11
CK1    INC  @FRM
       MOV  @FRM,R0
       CI   R0,60
       JHE  CK2
       B    *R11
CK2    CLR  @FRM
       INC  @SECS
       B    @STTIME

********************************************************************************
* telnet
********************************************************************************
* R1 = received byte
TNBYTE MOV  @TST,R2
       SLA  R2,1
       MOV  @TNJMP(R2),R2
       B    *R2
TNJMP  DATA TN0,TN1,TN2,TN3,TN4

TN0    CI   R1,>FF
       JEQ  TN0A
       B    @ANSI
TN0A   INC  @TST
       B    *R11
TN1    CI   R1,>FF
       JNE  TN1A
       CLR  @TST
       B    @ANSI
TN1A   CI   R1,>FB
       JL   TN1B
       MOV  R1,@TVERB
       LI   R0,2
       MOV  R0,@TST
       B    *R11
TN1B   CI   R1,>FA
       JNE  TN1C
       LI   R0,3
       MOV  R0,@TST
       CLR  @SBN
       B    *R11
TN1C   CLR  @TST
       B    *R11

* an option: R1 = option, TVERB = WILL / WONT / DO / DONT
TN2    CLR  @TST
       DECT R10
       MOV  R11,*R10
       MOV  R1,R5
       MOV  @TVERB,R0
       CI   R0,>FB
       JNE  TN2D
       LI   R6,>FE
       CI   R5,1
       JEQ  TN2A
       CI   R5,3
       JNE  TN2R
TN2A   LI   R6,>FD
       CI   R5,1
       JNE  TN2R
       SETO @SRVECH
       JMP  TN2R
TN2D   CI   R0,>FC
       JNE  TN2E
       CI   R5,1
       JNE  TN2X
       CLR  @SRVECH
       JMP  TN2X
TN2E   CI   R0,>FD
       JNE  TN2X
       LI   R6,>FC
       CI   R5,24
       JEQ  TN2W
       CI   R5,31
       JNE  TN2R
       LI   R6,>FB
       BL   @TNREP
       LI   R3,NAWS
       BL   @TXSTR
       MOV  @COLS,R1
       BL   @TXPUT
       CLR  R1
       BL   @TXPUT
       MOV  @ROWS,R1
       BL   @TXPUT
       LI   R1,>FF
       BL   @TXPUT
       LI   R1,>F0
       BL   @TXPUT
       JMP  TN2X
TN2W   LI   R6,>FB
TN2R   BL   @TNREP
TN2X   MOV  *R10+,R11
       B    *R11

* send IAC R6 R5
TNREP  DECT R10
       MOV  R11,*R10
       LI   R1,>FF
       BL   @TXPUT
       MOV  R6,R1
       BL   @TXPUT
       MOV  R5,R1
       BL   @TXPUT
       MOV  *R10+,R11
       B    *R11

* in a subnegotiation
TN3    CI   R1,>FF
       JNE  TN3A
       LI   R0,4
       MOV  R0,@TST
       B    *R11
TN3A   MOV  @SBN,R2
       CI   R2,8
       JHE  TN3B
       SWPB R1
       MOVB R1,@SBBUF(R2)
       INC  @SBN
TN3B   B    *R11
TN4    CI   R1,>F0
       JEQ  TN4A
       LI   R0,3
       MOV  R0,@TST
       LI   R1,>FF
       JMP  TN3A
TN4A   CLR  @TST
       CB   @SBBUF,@B24
       JNE  TN4X
       CB   @SBBUF+1,@B1
       JNE  TN4X
       LI   R3,TTYPE
       B    @TXSTR
TN4X   B    *R11

********************************************************************************
* ANSI / screen; R1 = byte
********************************************************************************
ANSI   MOV  @EST,R0
       JEQ  AN0
       DEC  R0
       JEQ  AN1
       B    @AN2
AN0    CI   R1,27
       JEQ  AN0A
       B    @CTRL
AN0A   INC  @EST
       B    *R11
AN1    CLR  @EST
       CI   R1,'['
       JNE  AN1A
       LI   R0,2
       MOV  R0,@EST
       CLR  @NP
       CLR  @PRIV
       LI   R0,PAR
       LI   R2,8
AN1Z   CLR  *R0+
       DEC  R2
       JNE  AN1Z
       B    *R11
AN1A   CI   R1,'c'
       JNE  AN1B
       DECT R10
       MOV  R11,*R10
       BL   @SGR0
       BL   @MKATTR
       MOV  *R10+,R11
       B    @CLRALL
AN1B   CI   R1,'7'
       JNE  AN1C
       B    @SAVEC
AN1C   CI   R1,'8'
       JNE  AN1D
       B    @RESTC
AN1D   B    *R11

* CSI: parameters, then the final byte
AN2    CI   R1,'0'
       JL   AN2A
       CI   R1,'9'
       JH   AN2A
       MOV  @NP,R2
       SLA  R2,1
       MOV  @PAR(R2),R3
       CI   R3,999
       JH   AN2Z
       LI   R4,10
       MPY  R4,R3
       AI   R1,-'0'
       A    R1,R4
       MOV  R4,@PAR(R2)
AN2Z   B    *R11
AN2A   CI   R1,';'
       JNE  AN2B
       MOV  @NP,R2
       CI   R2,7
       JHE  AN2Z
       INC  @NP
       B    *R11
AN2B   CI   R1,'?'
       JL   AN2C
       CI   R1,'?'
       JH   AN2C
       SETO @PRIV
       B    *R11
AN2C   CI   R1,'<'
       JL   AN2D
       CI   R1,'>'
       JH   AN2D
       SETO @PRIV
       B    *R11
AN2D   CI   R1,>40
       JL   AN2Z
       CI   R1,>7E
       JH   AN2Z
       CLR  @EST
       MOV  @PRIV,R0
       JNE  AN2Z
       MOV  @PAR,R2
       MOV  R2,R3
       JNE  AN2E
       INC  R3
AN2E   LI   R0,CSITAB
AN2F   MOV  *R0+,R4
       JEQ  AN2Z
       MOV  *R0+,R5
       C    R4,R1
       JNE  AN2F
       B    *R5
* R1 final, R2 first parameter, R3 same (at least 1)
CSITAB DATA 'A',CUU,'B',CUD,'C',CUF,'D',CUB,'H',CUP,'f',CUP
       DATA 'G',CHA,'d',VPA,'J',ED,'K',EL,'s',SAVEC,'u',RESTC
       DATA 'n',DSR6,'m',SGR,0

CUU    S    R3,@ROW
       JMP  CLAMP
CUD    A    R3,@ROW
       JMP  CLAMP
CUF    A    R3,@COL
       JMP  CLAMP
CUB    MOV  @COL,R0
       C    R0,@COLS
       JL   CUB1
       MOV  @COLS,R0
       DEC  R0
CUB1   S    R3,R0
       MOV  R0,@COL
       JMP  CLAMP
CUP    DEC  R3
       MOV  R3,@ROW
       MOV  @PAR+2,R3
       JNE  CUP1
       INC  R3
CUP1   DEC  R3
       MOV  R3,@COL
       JMP  CLAMP
CHA    DEC  R3
       MOV  R3,@COL
       JMP  CLAMP
VPA    DEC  R3
       MOV  R3,@ROW
* keep the cursor on the screen
CLAMP  MOV  @ROW,R0
       JGT  CL1
       CLR  @ROW
CL1    MOV  @ROWS,R1
       DEC  R1
       C    @ROW,R1
       JLE  CL2
       MOV  R1,@ROW
CL2    MOV  @COL,R0
       JGT  CL3
       CLR  @COL
CL3    MOV  @COLS,R1
       DEC  R1
       C    @COL,R1
       JLE  CL4
       MOV  R1,@COL
CL4    B    *R11

SAVEC  MOV  @ROW,@SROW
       MOV  @COL,@SCOL
       B    *R11
RESTC  MOV  @SROW,@ROW
       MOV  @SCOL,@COL
       B    *R11

* ESC [ 6 n: report the cursor, ESC [ row ; col R
DSR6   CI   R2,6
       JEQ  DS1
       B    *R11
DS1    DECT R10
       MOV  R11,*R10
       LI   R1,27
       BL   @TXPUT
       LI   R1,'['
       BL   @TXPUT
       MOV  @ROW,R1
       INC  R1
       BL   @TXDEC
       LI   R1,';'
       BL   @TXPUT
       MOV  @COL,R1
       C    R1,@COLS
       JL   DS2
       MOV  @COLS,R1
       DEC  R1
DS2    INC  R1
       BL   @TXDEC
       LI   R1,'R'
       BL   @TXPUT
       MOV  *R10+,R11
       B    *R11

* SGR: 0 reset, 1 / 22 bold, 7 / 27 inverse, 30-37 39 colour, 40-47 49 background
SGR    DECT R10
       MOV  R11,*R10
       CLR  R5
SG1    MOV  R5,R4
       SLA  R4,1
       MOV  @PAR(R4),R0
       JNE  SG2
       BL   @SGR0
       JMP  SG9
SG2    LI   R1,SGRTAB
SG3    MOV  *R1+,R2
       JEQ  SG5
       MOV  *R1+,R3
       MOV  *R1+,R4
       C    R0,R2
       JNE  SG3
       MOV  R4,*R3
       JMP  SG9
SG5    CI   R0,30
       JL   SG9
       CI   R0,37
       JH   SG6
       AI   R0,-30
       MOV  R0,@SGRFG
       JMP  SG9
SG6    CI   R0,40
       JL   SG9
       CI   R0,47
       JH   SG9
       AI   R0,-40
       MOV  R0,@SGRBG
SG9    INC  R5
       C    R5,@NP
       JLE  SG1
       BL   @MKATTR
       MOV  *R10+,R11
       B    *R11
SGRTAB DATA 1,SGRBLD,1,22,SGRBLD,0,7,INVM,1,27,INVM,0
       DATA 39,SGRFG,-1,49,SGRBG,-1,0
SGR0   CLR  @INVM
       CLR  @SGRBLD
       SETO @SGRFG
       SETO @SGRBG
       B    *R11

* the colour byte of the 80 columns: ANSI colours (the palette of F80INI) or
* the menus' palette; inverse swaps the two
MKATTR MOV  @COLR,R0
       JEQ  MK5
       LI   R1,7
       MOV  @SGRFG,R0
       JLT  MK1
       MOV  R0,R1
MK1    MOV  @SGRBLD,R0
       JEQ  MK2
       ORI  R1,8
MK2    CLR  R2
       MOV  @SGRBG,R0
       JLT  MK6
       MOV  R0,R2
       JMP  MK6
MK5    MOV  @PALV,R1
       MOV  R1,R2
       SRL  R1,4
       ANDI R2,>000F
MK6    MOV  @INVM,R0
       JEQ  MK7
       MOV  R1,R0
       MOV  R2,R1
       MOV  R0,R2
MK7    SLA  R1,4
       SOC  R2,R1
       MOV  R1,@CATTR
       B    *R11

* erase in display: 0 to the end, 1 from the start, 2 all
ED     DECT R10
       MOV  R11,*R10
       MOV  @PAR,R2
       JNE  ED1
       MOV  @ROW,R5
       MOV  @COL,R6
       BL   @BLEOL
       MOV  @ROW,R5
       INC  R5
       MOV  @ROWS,R2
       S    R5,R2
       BL   @BLROWS
       JMP  ED9
ED1    DEC  R2
       JNE  ED2
       CLR  R5
       MOV  @ROW,R2
       BL   @BLROWS
       MOV  @ROW,R5
       CLR  R6
       MOV  @COL,R2
       INC  R2
       BL   @BLANK
       JMP  ED9
ED2    BL   @CLRALL
ED9    MOV  *R10+,R11
       B    *R11

* erase in line: 0 to the end, 1 from the start, 2 the line
EL     DECT R10
       MOV  R11,*R10
       MOV  @ROW,R5
       MOV  @PAR,R2
       JNE  EL1
       MOV  @COL,R6
       BL   @BLEOL
       JMP  EL9
EL1    DEC  R2
       JNE  EL2
       CLR  R6
       MOV  @COL,R2
       INC  R2
       BL   @BLANK
       JMP  EL9
EL2    LI   R2,1
       BL   @BLROWS
EL9    MOV  *R10+,R11
       B    *R11

********************************************************************************
* the screen, 40 / 80 columns (text modes) or 64 (bitmap): rows R5, columns R6
********************************************************************************
* row R5 from column R6 to the end of the line
BLEOL  MOV  @COLS,R2
       S    R6,R2
       JGT  BLANK
       B    *R11

* R2 characters of row R5 from column R6: blank
BLANK  MOV  R2,R2
       JGT  BN1
       B    *R11
BN1    MOV  R6,R0
       A    R2,R0
       C    R0,@COLS
       JLE  BN2
       MOV  @COLS,R2
       S    R6,R2
BN2    MOV  @COLM,R0
       DEC  R0
       JEQ  BN4
       MOV  R5,R3
       MPY  @ROWB,R3
       A    R6,R4
       MOV  R4,R0
       JMP  BLFILL
BN4    MOV  R6,R6
       JNE  BN5
       C    R2,@COLS
       JL   BN5
       LI   R2,1
       JMP  BLROWS
BN5    DECT R10
       MOV  R11,*R10
BN6    DECT R10
       MOV  R2,*R10
       LI   R1,32
       BL   @PUTAT
       MOV  *R10+,R2
       INC  R6
       DEC  R2
       JNE  BN6
       MOV  *R10+,R11
       B    *R11

* R2 whole rows from row R5: blank
BLROWS MOV  R2,R2
       JGT  BR1
       B    *R11
BR1    MOV  R5,R3
       MPY  @ROWB,R3
       MOV  R4,R0
       MOV  R2,R3
       MPY  @ROWB,R3
       MOV  R4,R2
       MOV  @COLM,R1
       DEC  R1
       JNE  BLFILL
       MOV  @FILLB,R1
       B    @VFILL
* text modes: R2 spaces from R0; in 80 columns their colour bytes too
BLFILL MOV  @COLM,R1
       JEQ  BF2
       DECT R10
       MOV  R11,*R10
       DECT R10
       MOV  R0,*R10
       DECT R10
       MOV  R2,*R10
       AI   R0,ATR80
       MOV  @CATTR,R1
       SWPB R1
       BL   @VFILL
       MOV  *R10+,R2
       MOV  *R10+,R0
       MOV  *R10+,R11
BF2    LI   R1,>2000
       B    @VFILL

* clear the BBS rows and home the cursor
CLRALL CLR  @ROW
       CLR  @COL
       CLR  R5
       MOV  @ROWS,R2
       JMP  BLROWS

* control characters and printable bytes; R1 = byte
CTRL   CI   R1,13
       JNE  CT1
       CLR  @COL
       B    *R11
CT1    CI   R1,10
       JNE  CT2
       B    @LF
CT2    CI   R1,8
       JNE  CT3
       MOV  @COL,R0
       JEQ  CT2A
       C    R0,@COLS
       JL   CT2B
       MOV  @COLS,R0
CT2B   DEC  R0
       MOV  R0,@COL
CT2A   B    *R11
CT3    CI   R1,9
       JNE  CT4
       MOV  @COL,R0
       AI   R0,8
       ANDI R0,>FFF8
       C    R0,@COLS
       JL   CT3A
       MOV  @COLS,R0
       DEC  R0
CT3A   MOV  R0,@COL
       B    *R11
CT4    CI   R1,12
       JNE  CT5
       B    @CLRALL
CT5    CI   R1,32
       JL   CT9
       CI   R1,127
       JEQ  CT9
* printable: with the wrap deferred to the next character (as a VT100)
       DECT R10
       MOV  R11,*R10
       MOV  @COL,R0
       C    R0,@COLS
       JL   CT6
       CLR  @COL
       DECT R10
       MOV  R1,*R10
       BL   @LF
       MOV  *R10+,R1
CT6    MOV  @ROW,R5
       MOV  @COL,R6
       BL   @PUTAT
       INC  @COL
       MOV  *R10+,R11
CT9    B    *R11

* line feed, scrolling at the bottom
LF     MOV  @ROW,R0
       INC  R0
       C    R0,@ROWS
       JHE  SCROLL
       MOV  R0,@ROW
       B    *R11
* one row up: row by row through SCRBUF (ROWB bytes a row in all the modes);
* in 80 columns the colour bytes too
SCROLL DECT R10
       MOV  R11,*R10
       CLR  R6
       BL   @SCRL1
       MOV  @COLM,R0
       CI   R0,2
       JNE  SC8
       LI   R6,ATR80
       BL   @SCRL1
SC8    MOV  @ROWS,R5
       DEC  R5
       LI   R2,1
       BL   @BLROWS
       MOV  *R10+,R11
       B    *R11
SCRL1  DECT R10
       MOV  R11,*R10
       LI   R5,1
SC1    C    R5,@ROWS
       JHE  SC9
       MOV  R5,R3
       MPY  @ROWB,R3
       A    R6,R4
       MOV  R4,R0
       LI   R1,SCRBUF
       MOV  @ROWB,R2
       BL   @VMBR
       MOV  R5,R3
       DEC  R3
       MPY  @ROWB,R3
       A    R6,R4
       MOV  R4,R0
       LI   R1,SCRBUF
       MOV  @ROWB,R2
       BL   @VMBW
       INC  R5
       JMP  SC1
SC9    MOV  *R10+,R11
       B    *R11

* character R1 (low byte) at row R5, column R6; keeps R5, R6
PUTAT  MOV  @COLM,R0
       JEQ  PT40
       DEC  R0
       JEQ  BPUT
       MOV  R11,R7                    * 80 columns: the character and its colour
       MOV  R5,R3
       LI   R0,80
       MPY  R0,R3
       A    R6,R4
       MOV  R4,R0
       BL   @VWA
       SWPB R1
       MOVB R1,@VDPWD
       MOV  R4,R0
       AI   R0,ATR80
       BL   @VWA
       MOVB @CATTR+1,@VDPWD
       B    *R7
PT40   MOV  @INVM,R0                  * 40 columns: inverse from inverse.py
       JEQ  PT41
       CI   R1,32
       JL   PT41
       CI   R1,126
       JH   PT41
       MOVB @INVMAP-32(R1),R1
       SRL  R1,8
PT41   MOV  R5,R3
       LI   R0,40
       MPY  R0,R3
       A    R6,R4
       MOV  R4,R0
       SWPB R1
       B    @VSBW
* bitmap: the cell is a nibble of the 8 bytes at row * 256 + (column / 2) * 8
BPUT   DECT R10
       MOV  R11,*R10
       MOV  R1,R3
       ANDI R3,>00FF
       SLA  R3,3
       AI   R3,FONT64
       BL   @BADDR
       CLR  R12
       MOV  @INVM,R0
       JEQ  BP1
       LI   R12,>F000
BP1    LI   R2,BTMP
       LI   R4,8
       MOV  R6,R0
       ANDI R0,1
       JNE  BP3
BP2    MOVB *R3+,R7
       XOR  R12,R7
       MOVB *R2,R0
       ANDI R0,>0F00
       SOCB R7,R0
       MOVB R0,*R2+
       DEC  R4
       JNE  BP2
       JMP  BP5
BP3    MOVB *R3+,R7
       XOR  R12,R7
       SRL  R7,4
       MOVB *R2,R0
       ANDI R0,>F000
       SOCB R7,R0
       MOVB R0,*R2+
       DEC  R4
       JNE  BP3
BP5    MOV  R9,R0
       BL   @VWA
       LI   R2,BTMP
       LI   R4,8
BP6    MOVB *R2+,@VDPWD
       DEC  R4
       JNE  BP6
       MOV  *R10+,R11
       B    *R11
* the 8 bytes of cell R5, R6 -> BTMP, their address -> R9
BADDR  MOV  R5,R0
       SWPB R0
       ANDI R0,>FF00
       MOV  R6,R2
       SRL  R2,1
       SLA  R2,3
       A    R2,R0
       MOV  R0,R9
       MOV  R11,R7
       BL   @VRA
       LI   R2,BTMP
       LI   R4,8
BA1    MOVB @VDPRD,*R2+
       DEC  R4
       JNE  BA1
       B    *R7
* bitmap: invert cell R5, R6 (the cursor)
BINV   DECT R10
       MOV  R11,*R10
       BL   @BADDR
       LI   R7,>F000
       MOV  R6,R0
       ANDI R0,1
       JEQ  BI1
       LI   R7,>0F00
BI1    LI   R2,BTMP
       LI   R4,8
BI2    MOVB *R2,R0
       XOR  R7,R0
       MOVB R0,*R2+
       DEC  R4
       JNE  BI2
       JMP  BP5

* string R1 (ending with 0, at most R2 characters) at row R5 from column R6
SPRT   DECT R10
       MOV  R11,*R10
SP1    CLR  R3
       MOVB *R1+,R3
       JEQ  SP9
       DECT R10
       MOV  R1,*R10
       DECT R10
       MOV  R2,*R10
       SWPB R3
       MOV  R3,R1
       BL   @PUTAT
       MOV  *R10+,R2
       MOV  *R10+,R1
       INC  R6
       DEC  R2
       JNE  SP1
SP9    MOV  *R10+,R11
       B    *R11

* the cursor: a block (text mode) or an inverted cell (bitmap), drawn while idle
CURSHW MOV  @CURON,R0
       JNE  CU9
       MOV  @COL,R0
       C    R0,@COLS
       JHE  CU9
       DECT R10
       MOV  R11,*R10
       MOV  @ROW,R5
       MOV  @COL,R6
       MOV  R5,@CURR
       MOV  R6,@CURC
       MOV  @COLM,R0
       DEC  R0
       JEQ  CS2
       MOV  R5,R3
       MPY  @ROWB,R3
       A    R6,R4
       MOV  R4,R0
       MOV  R0,@CURAD
       BL   @VRA
       MOVB @VDPRD,@CURCH
       MOV  @CURAD,R0
       LI   R1,>DB00
       BL   @VSBW
       JMP  CS3
CS2    BL   @BINV
CS3    SETO @CURON
       MOV  *R10+,R11
CU9    B    *R11
CUROFF MOV  @CURON,R0
       JEQ  CU9
       CLR  @CURON
       MOV  @COLM,R0
       DEC  R0
       JEQ  CO2
       MOV  @CURAD,R0
       MOVB @CURCH,R1
       B    @VSBW
CO2    MOV  @CURR,R5
       MOV  @CURC,R6
       B    @BINV

* 64 columns: bitmap mode, patterns >0000 (6K), names >1800, colours >2000
* (R3 = >9F: 2K shared by the three thirds, so the disk buffers at the top of
* the VDP memory stay untouched), no sprites
BMINIT DECT R10
       MOV  R11,*R10
       LI   R0,>0002
       BL   @VWTR
       LI   R0,>01E0
       BL   @VWTR
       LI   R0,>E000
       MOVB R0,@>83D4                * KSCAN restores VDP R1 from here
       LI   R0,>0206
       BL   @VWTR
       LI   R0,>039F
       BL   @VWTR
       LI   R0,>0403
       BL   @VWTR
       LI   R0,>0536
       BL   @VWTR
       LI   R0,>0600
       BL   @VWTR
       MOV  @PALV,R0
       ANDI R0,>000F
       AI   R0,>0700
       BL   @VWTR
       CLR  R0
       CLR  R1
       LI   R2,>1800
       BL   @VFILL
       LI   R0,>1800
       BL   @VWA
       CLR  R1
       LI   R2,768
BMI1   MOVB R1,@VDPWD
       AI   R1,>0100
       DEC  R2
       JNE  BMI1
       LI   R0,>1B00
       LI   R1,>D000
       BL   @VSBW
       LI   R0,>2000
       MOV  @PALV,R1
       SWPB R1
       LI   R2,>0800
       BL   @VFILL
       MOV  *R10+,R11
       B    *R11

* 80 columns (F18A): unlocked, 80-column text mode with 30 rows (25 for the BBS,
* the status row, 4 blank), a colour byte for each position (R50 >02);
* names >0000, patterns >2000 (the menus' font, copied), colours >2800
F80INI DECT R10
       MOV  R11,*R10
       CLR  R5
FI1    LI   R0,PATTAB
       A    R5,R0
       LI   R1,SCRBUF
       LI   R2,256
       BL   @VMBR
       LI   R0,PAT80
       A    R5,R0
       LI   R1,SCRBUF
       LI   R2,256
       BL   @VMBW
       AI   R5,256
       CI   R5,2048
       JL   FI1
       LI   R0,>F000
       MOVB R0,@>83D4                * KSCAN restores VDP R1 from here
       LI   R3,F80REG
FI2    MOV  *R3+,R0
       JEQ  FI3
       BL   @VWTR
       JMP  FI2
FI3    MOV  @COLR,R0
       JEQ  FI4
       LI   R1,PALCGA                 * the 16 ANSI colours, black border
       BL   @PALSET
       LI   R0,>0700
       JMP  FI5
FI4    MOV  @PALV,R0
       AI   R0,>0700
FI5    BL   @VWTR
       CLR  R0
       LI   R1,>2000
       LI   R2,2400
       BL   @VFILL
       LI   R0,ATR80
       MOV  @DEFATR,R1
       SWPB R1
       LI   R2,2400
       BL   @VFILL
       MOV  *R10+,R11
       B    *R11
F80REG DATA >391C,>391C,>0004,>01F0,>0200,>03A0,>0404,>3140,>3202,0
* back: the palette of the 9918, the registers reset (and locked)
F80OFF DECT R10
       MOV  R11,*R10
       MOV  @COLR,R0
       JEQ  FO1
       LI   R1,PALTMS
       BL   @PALSET
FO1    LI   R0,>3280
       BL   @VWTR
       MOV  *R10+,R11
       B    *R11
* the 16 palette registers from R1 (two bytes each: 0R GB)
PALSET DECT R10
       MOV  R11,*R10
       LI   R0,>2FC0
       BL   @VWTR
       LI   R2,32
PS1    MOVB *R1+,@VDPWD
       DEC  R2
       JNE  PS1
       LI   R0,>2F00
       BL   @VWTR
       MOV  *R10+,R11
       B    *R11
PALCGA BYTE >00,>00,>0A,>00,>00,>A0,>0A,>50,>00,>0A,>0A,>0A,>00,>AA,>0A,>AA
       BYTE >05,>55,>0F,>55,>05,>F5,>0F,>F5,>05,>5F,>0F,>5F,>05,>FF,>0F,>FF
PALTMS BYTE >00,>00,>00,>00,>02,>C3,>05,>D6,>05,>4F,>07,>6F,>0D,>54,>04,>EF
       BYTE >0F,>54,>0F,>76,>0D,>C3,>0E,>D6,>02,>B2,>0C,>5C,>0C,>CC,>0F,>FF

********************************************************************************
* the network commands of the terminal
********************************************************************************
* the bytes waiting in TXBUF -> SEND, 31 at a time
TXFLSH MOV  @TXN,R2
       JNE  TF0
       B    *R11
TF0    DECT R10
       MOV  R11,*R10
       LI   R1,TXBUF
TF1    MOV  R2,R3
       CI   R3,31
       JLE  TF2
       LI   R3,31
TF2    S    R3,R2
       MOV  R3,R4
       SWPB R4
       MOVB R4,@CALLBF
       LI   R5,CALLBF+1
TF3    MOVB *R1+,*R5+
       DEC  R3
       JNE  TF3
       LI   R0,>7100
       BL   @NETCMD
       MOV  R2,R2
       JNE  TF1
       CLR  @TXN
       MOV  *R10+,R11
       B    *R11

* R1 = byte -> TXBUF (keeps R1)
TXPUT  MOV  @TXN,R2
       CI   R2,64
       JHE  TP9
       SWPB R1
       MOVB R1,@TXBUF(R2)
       SWPB R1
       INC  @TXN
TP9    B    *R11

* R3 = string (length byte first) -> TXBUF
TXSTR  DECT R10
       MOV  R11,*R10
       MOVB *R3+,R5
       SRL  R5,8
TS1    CLR  R1
       MOVB *R3+,R1
       SWPB R1
       BL   @TXPUT
       DEC  R5
       JNE  TS1
       MOV  *R10+,R11
       B    *R11

* R1 = 0-999 in decimal -> TXBUF
TXDEC  DECT R10
       MOV  R11,*R10
       MOV  R1,R7
       CLR  R6
       LI   R2,10
       DIV  R2,R6
       MOV  R6,R6
       JEQ  TD1
       MOV  R6,R1
       AI   R1,'0'
       BL   @TXPUT
TD1    MOV  R7,R1
       AI   R1,'0'
       BL   @TXPUT
       MOV  *R10+,R11
       B    *R11

********************************************************************************
* data (bank 1)
********************************************************************************
B24    BYTE 24
B1     BYTE 1
COLON  TEXT ':'
TTYPE  BYTE 10,>FF,>FA,24,0
       TEXT 'ANSI'
       BYTE >FF,>F0
NAWS   BYTE 4,>FF,>FA,31,0
       EVEN
* status row: host length, then the columns of host... ANSI, time, F9
STP40  DATA 14,16,27,33
STP64  DATA 30,33,45,57
STP80  DATA 30,33,58,72
MANS40 TEXT 'ANSI 40x23'
       BYTE 0
MANS64 TEXT 'ANSI 64x23'
       BYTE 0
MANS80 TEXT 'ANSI 80x25'
       BYTE 0
MF9    TEXT 'F9 MENU'
       BYTE 0
       EVEN

       .ifdef ITALIAN
       COPY "term_it.a99"
       .else
       COPY "term_en.a99"
       .endif

       COPY "inv1.a99"
