       BYTE 0
MEMPTY BYTE 0
MDELQ  TEXT 'Cancello quale voce (1-9)?'
       BYTE 0
MDELD  TEXT 'Voce cancellata.'
       BYTE 0
MYES   TEXT 'SI            '
       BYTE 0
MNO    TEXT 'NO            '
       BYTE 0
